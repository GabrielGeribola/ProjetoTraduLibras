# Copie para .env e preencha. O .env nunca vai para o Git.

# Banco MySQL
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=app_tradu_embedding

# Sessão (texto aleatório e longo)
SESSION_SECRET=

# E-mail ("Esqueci a senha") via Gmail.
# SMTP_PASS é uma senha de app de 16 letras (https://myaccount.google.com/apppasswords),
# não a senha normal da conta. Sem SMTP_PASS o link aparece no terminal do Node.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tradulibras.fam@gmail.com
SMTP_PASS=
SMTP_FROM="TraduLibras <tradulibras.fam@gmail.com>"

# Endereço público do site, usado nos links enviados por e-mail ("Esqueci a senha").
# No SERVIDOR troque pelo endereço real (ex.: https://tradulibras.com.br): com localhost, o link do
# e-mail não abre para quem o recebe, e o site se recusa a enviar (o motivo aparece no log e na administração).
APP_URL=http://localhost:3000

# ── Ligação site (Node) ↔ API (Python): tradução e área de administração ──
# Texto aleatório e longo, IGUAL no site (Node) e na API (Python). OBRIGATÓRIO: a tradução passa pelo
# site (que aplica o limite de tokens do plano) e chega à API pelas rotas internas protegidas por ele.
# Sem ele, o tradutor, a importação do S3, as embeddings e o "recarregar o tradutor" ficam desligados.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_INTERNO=
# Endereço da API visto pelo servidor Node (no Docker, o nome do serviço: http://api:5000)
API_INTERNA_URL=http://localhost:5000

# S3 (lido pela API Python). Buckets com os vídeos dos sinais, separados por vírgula.
S3_BUCKETS=words-traducao,tradulibras-videos
AWS_REGION=us-east-1
# Credenciais com permissão s3:ListBucket nos buckets acima (dispensáveis se o servidor tiver papel IAM)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
