<%- include('includes/head'); %>

  <div class="container">

    <div class="logo-boasvindas-login">
      <img src="https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/logo-clara.png" alt="Logo TraduLibras" class="img-fluid" />
    </div>

    <div class="row">
      <div class="col-lg-2"></div>

      <div class="col-lg-8 my-3">
        <div class="row">
          <%- include('includes/messages'); %>

          <div class="">
            <h4 class="entrar">Cadastro</h4>

            <form action="/register" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-group">
                <label class="diminutivo" for="cadastro_email">Digite seu e-mail</label>
                <br>
                <input type="email" class="form-control" id="cadastro_email" name="email" placeholder="Email" autocomplete="email" required>
              </div>

              <div class="form-group">
                <label class="diminutivo" for="cadastro_senha">Digite sua senha (mínimo de 10 caracteres)</label>
                <br>
                <input type="password" class="form-control" id="cadastro_senha" name="password" placeholder="Senha" autocomplete="new-password" minlength="10" required>
              </div>

              <button type="submit" class="btn-criar-conta">Criar minha conta</button>
            </form>


            <div class="linha"></div>
            <p class="tem-conta">Ja tem conta? </p>
            <a class="linkp-register" href="/login">Faça login</a>
          </div>
        </div>
      </div>
    </div>
  </div>

<%- include('includes/footer'); %>
