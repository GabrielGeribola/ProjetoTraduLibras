<%- include('includes/head'); %>

<body>
  <main>
    <%- include('includes/navbar'); %>

    <!-- Modal de Vídeo Tutorial -->
    <div class="tutorial-overlay" id="tutorialOverlay">
      <div class="tutorial-modal">
        <div class="tutorial-modal-header">
          <span>📹 Vídeo Tutorial</span>
          <button class="tutorial-close" id="tutorialClose" aria-label="Fechar">✕</button>
        </div>
        <div class="tutorial-video-wrap">
          <video
            id="tutorialVideo"
            controls
            autoplay
            playsinline
            style="width:100%; border-radius:12px;">
          </video>
        </div>
        <p class="tutorial-caption">Aprenda a usar o TraduLibras em poucos minutos.</p>
      </div>
    </div>

    <div class="container-home" id="homeContent">

      <!-- Cabeçalho com título e botão tutorial -->
      <div class="home-header-row">
        <h2 class="translate-home">TRADUTOR</h2>
        <button class="btn-tutorial" id="btnTutorial" aria-label="Abrir vídeo tutorial">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/>
          </svg>
          Tutorial
        </button>
      </div>

      <div class="digite-expressao">
        <p>Digite uma palavra ou expressão ou grave sua voz:</p>
      </div>

      <form id="searchForm" class="input-group">
        <input type="text" class="input-home" id="input_text" name="input_text" placeholder="Exemplo: Abraço">
        <button class="btn-home" type="submit">&gt;</button>
        <button type="button" class="btn-home" id="recordBtn">🎤 Gravar Áudio</button>
      </form>

      <div class="resultado" id="result"></div>

      <div class="feedback-container" id="feedback" style="display: none;">
        <p>Esse era o resultado esperado?</p>
        <div class="feedback-buttons">
          <button onclick="enviarFeedback(true)" class="btn-feedback btn-sim">👍 Sim</button>
          <button onclick="enviarFeedback(false)" class="btn-feedback btn-nao">👎 Não</button>
        </div>
      </div>

      <div class="buttons-cards">
        <a href="/home" class="card-traduzir">
          <p class="icon-traduzir">🔁</p>
          <h3 class="title-card">Traduzir</h3>
          <p class="descricao-card">Converta palavras em Libras de forma rápida e intuitiva.</p>
        </a>
        <a href="/cursos" class="card-aprender">
          <p class="icon-aprender">📖</p>
          <h3 class="title-card">Aprender</h3>
          <p class="descricao-card">Descubra novos sinais e amplie seu conhecimento em Libras.</p>
        </a>
        <a href="/sugestoes" class="card-incluir">
          <p class="icon-incluir">🤗</p>
          <h3 class="title-card">Incluir</h3>
          <p class="descricao-card">Facilite a comunicação e torne o diálogo mais acessível.</p>
        </a>
      </div>
    </div>

    <!-- Chat dinâmico (inicia escondido) -->
    <div id="chatWrapper" style="display: none">
      <div class="chat-container" id="chatContainer"></div>

      <form id="chatForm" class="chat-input-container" style="display:flex; gap:8px; align-items:center;">
        <input type="text" class="input-home" id="chat_input" name="chat_input" placeholder="Digite aqui..." style="flex:1;">
        <button type="button" class="btn-home" id="chatRecordBtn" title="Gravar áudio no chat">🎤</button>
        <button class="btn-home" type="submit" title="Enviar">›</button>
      </form>
    </div>
<script>
  // ── Vídeo Tutorial ────────────────────────────────────────
  const TUTORIAL_URL =
    'https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/tutorial_tradulibras_com_som.mp4';

  const btnTutorial     = document.getElementById('btnTutorial');
  const tutorialOverlay = document.getElementById('tutorialOverlay');
  const tutorialClose   = document.getElementById('tutorialClose');
  const tutorialVideo   = document.getElementById('tutorialVideo');

  btnTutorial.addEventListener('click', () => {
    tutorialVideo.src = TUTORIAL_URL;
    tutorialVideo.load();

    tutorialOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  });

  function closeTutorial() {
    tutorialOverlay.classList.remove('open');

    tutorialVideo.pause();
    tutorialVideo.src = '';

    document.body.style.overflow = '';
  }

  tutorialClose.addEventListener('click', closeTutorial);

  tutorialOverlay.addEventListener('click', e => {
    if (e.target === tutorialOverlay) closeTutorial();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeTutorial();
  });


  // ── API / Tradutor ────────────────────────────────────────

  const params = new URLSearchParams(window.location.search);
  const palavraUrl = params.get('word');

  const API_BASE = '';

  let ultimaEntrada  = '';
  let ultimaSugestao = '';
  let ultimoScore    = 0.0;
  let currentStream  = null;


  // ── Elementos da página ───────────────────────────────────

  const resultDiv     = document.getElementById('result');
  const feedbackDiv   = document.getElementById('feedback');
  const homeContent   = document.getElementById('homeContent');
  const chatWrapper   = document.getElementById('chatWrapper');
  const chatContainer = document.getElementById('chatContainer');
  const searchForm    = document.getElementById('searchForm');
  const chatForm      = document.getElementById('chatForm');
  const chatInput     = document.getElementById('chat_input');
  const recordBtn     = document.getElementById('recordBtn');
  const chatRecordBtn = document.getElementById('chatRecordBtn');


  // ── Adiciona mensagem no chat ─────────────────────────────

  function appendMessage(content, sender = 'user', asHtml = false) {

    const msg = document.createElement('div');

    msg.classList.add('chat-bubble', sender);

    if (sender === 'bot' && asHtml) {
      msg.innerHTML = content;
    } else {
      msg.textContent = content;
    }

    chatContainer.appendChild(msg);

    chatContainer.scrollTop = chatContainer.scrollHeight;

    // IMPORTANTE:
    // Retornamos o elemento criado para podermos
    // encontrar o vídeo daquela mensagem específica.
    return msg;
  }


  // ── Sequência de animações ────────────────────────────────

  function iniciarSequenciaAnimacoes(video, termoEl, sequencia) {

    if (!video || !sequencia || sequencia.length === 0) {
      return;
    }

    let indiceAtual = 0;


    // Função responsável por reproduzir a animação atual
    function reproduzirAnimacaoAtual() {

      const animacao = sequencia[indiceAtual];

      if (!animacao || !animacao.url) {
        return;
      }


      // Troca o vídeo
      video.src = animacao.url;

      video.load();


      // Mostra o sinal que está sendo reproduzido
      if (termoEl) {

        termoEl.textContent =
          animacao.expressao_libras ||
          animacao.termo_original ||
          '';
      }


      // Reproduz automaticamente
      video.play().catch(error => {

        console.warn(
          'O navegador bloqueou a reprodução automática:',
          error
        );

      });

    }


    // Quando um vídeo terminar
    video.addEventListener('ended', function () {

      // Vai para o próximo
      indiceAtual++;


      // Se chegou ao final da frase,
      // volta para o primeiro sinal.
      if (indiceAtual >= sequencia.length) {

        indiceAtual = 0;

      }


      // Reproduz o próximo vídeo
      reproduzirAnimacaoAtual();

    });


    // Começa pelo primeiro vídeo
    reproduzirAnimacaoAtual();
  }



  // ── Envio de texto pelo input inicial ─────────────────────

  searchForm.addEventListener('submit', async function (event) {

    event.preventDefault();

    const inputText =
      document.getElementById('input_text').value.trim();

    if (!inputText) {
      return;
    }


    homeContent.style.display = 'none';

    chatWrapper.style.display = 'block';

    chatInput.value = inputText;

    chatForm.dispatchEvent(
      new Event('submit')
    );

  });



  // ── Tradução pelo chat ────────────────────────────────────

  chatForm.addEventListener('submit', async function (event) {

    event.preventDefault();


    const inputText = chatInput.value.trim();

    if (!inputText) {
      return;
    }


    ultimaEntrada = inputText;


    // Mostra o que o usuário digitou
    appendMessage(
      inputText,
      'user'
    );


    chatInput.value = '';


    try {

      const response = await fetch(
        `${API_BASE}/api/sugestao`,
        {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({
            texto: inputText
          })
        }
      );


      let data;


      try {

        data = await response.json();

      } catch (err) {

        appendMessage(
          'Erro do servidor ao buscar sugestão.',
          'bot'
        );

        return;
      }



      // ── RESPOSTA COM SUCESSO ───────────────────────────────

      if (response.ok) {


        // Verifica se a API retornou a sequência
        const sequencia = data.sequencia || [];


        if (sequencia.length === 0) {

          appendMessage(
            'A tradução foi processada, mas nenhuma animação foi encontrada.',
            'bot'
          );

          return;
        }


        // Guarda informações para o feedback
        ultimaSugestao = data.glosa || '';

        ultimoScore =
          sequencia[0]?.score ?? 0.0;



        // ── HTML da resposta ────────────────────────────────

        const botMessage = `

          <div class="traducao-resultado">

            <p>
              <strong>Frase:</strong>
              ${data.frase_original || inputText}
            </p>


            <p>
              <strong>Glosa:</strong>
              ${data.glosa || ''}
            </p>


            <div class="video-container">

              <video
                class="video-libras"
                controls
                playsinline>
                Seu navegador não suporta vídeo.
              </video>


              <p class="termo-atual">

                Sinal:
                <strong class="termo-animacao"></strong>

              </p>

            </div>


            <div class="feedback-inline">

              <span>
                Esse era o resultado esperado?
              </span>

              <button
                onclick="enviarFeedback(true)">
                👍
              </button>

              <button
                onclick="enviarFeedback(false)">
                👎
              </button>

            </div>

          </div>

        `;



        // Adiciona a mensagem no chat
        const botMessageElement =
          appendMessage(
            botMessage,
            'bot',
            true
          );



        // ── Localiza o vídeo dessa mensagem ─────────────────

        const video =
          botMessageElement.querySelector(
            '.video-libras'
          );


        const termo =
          botMessageElement.querySelector(
            '.termo-animacao'
          );



        // ── Inicia a sequência ──────────────────────────────

        iniciarSequenciaAnimacoes(
          video,
          termo,
          sequencia
        );


      } else {


        // ── ERRO DA API ────────────────────────────────────

        appendMessage(
          data.mensagem ||
          'Erro ao buscar expressão.',
          'bot'
        );

      }


    } catch (err) {


      console.error(
        'Erro na requisição:',
        err
      );


      appendMessage(
        'Erro de rede ao buscar expressão.',
        'bot'
      );

    }

  });



  // ── Feedback ──────────────────────────────────────────────

  async function enviarFeedback(foiUtil) {

    try {

      const response = await fetch(
        `${API_BASE}/api/feedback`,
        {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({

            entrada: ultimaEntrada,

            sugestao: ultimaSugestao,

            score: ultimoScore,

            foi_util: foiUtil

          })

        }
      );


      let data;


      try {

        data = await response.json();

      } catch (err) {

        appendMessage(
          'Erro ao enviar feedback.',
          'bot'
        );

        return;
      }


      appendMessage(
        data.mensagem ||
        'Feedback recebido!',
        'bot'
      );


    } catch (err) {

      appendMessage(
        'Erro ao enviar feedback.',
        'bot'
      );

    }

  }



  // ── Gravação de áudio da tela inicial ─────────────────────

  recordBtn.addEventListener('click', async () => {

    recordBtn.disabled = true;

    recordBtn.textContent = '🎙️ Gravando...';


    try {

      const stream =
        await navigator.mediaDevices.getUserMedia({
          audio: true
        });


      currentStream = stream;


      const mediaRecorder =
        new MediaRecorder(stream);


      const chunks = [];


      mediaRecorder.ondataavailable =
        e => chunks.push(e.data);



      mediaRecorder.onstop = async () => {


        try {

          if (currentStream) {

            currentStream
              .getTracks()
              .forEach(t => t.stop());

            currentStream = null;

          }

        } catch (e) {}



        const blob =
          new Blob(
            chunks,
            {
              type: 'audio/webm'
            }
          );


        const formData =
          new FormData();


        formData.append(
          'file',
          blob,
          'recording.webm'
        );


        appendMessage(
          'Enviando áudio para transcrição...',
          'bot'
        );


        let response;


        try {

          response =
            await fetch(
              `${API_BASE}/api/transcrever`,
              {
                method: 'POST',
                body: formData
              }
            );


        } catch (err) {

          appendMessage(
            'Erro de rede ao enviar áudio.',
            'bot'
          );

          recordBtn.disabled = false;

          recordBtn.textContent =
            '🎤 Gravar Áudio';

          return;
        }



        if (!response.ok) {

          appendMessage(
            'Erro ao transcrever (status ' +
            response.status +
            ')',
            'bot'
          );

          recordBtn.disabled = false;

          recordBtn.textContent =
            '🎤 Gravar Áudio';

          return;

        }



        let data;


        try {

          data =
            await response.json();

        } catch (err) {

          appendMessage(
            'Resposta inválida do servidor.',
            'bot'
          );

          recordBtn.disabled = false;

          recordBtn.textContent =
            '🎤 Gravar Áudio';

          return;
        }



        // A API retorna texto_transcrito
        if (data.texto_transcrito) {


          homeContent.style.display =
            'none';


          chatWrapper.style.display =
            'block';


          chatInput.value =
            data.texto_transcrito;


          appendMessage(
            `Transcrição: "${data.texto_transcrito}"`,
            'bot'
          );


          setTimeout(() => {

            chatForm.dispatchEvent(
              new Event('submit')
            );

          }, 100);


        } else {


          appendMessage(
            data.mensagem ||
            'Não foi possível transcrever o áudio.',
            'bot'
          );

        }



        recordBtn.disabled = false;

        recordBtn.textContent =
          '🎤 Gravar Áudio';

      };



      mediaRecorder.start();


      appendMessage(
        '🎤 Gravando áudio por 5 segundos...',
        'bot'
      );


      setTimeout(() => {

        if (
          mediaRecorder.state !==
          'inactive'
        ) {

          mediaRecorder.stop();

        }

      }, 5000);



    } catch (err) {


      appendMessage(
        'Permissão negada ou erro ao acessar microfone.',
        'bot'
      );


      recordBtn.disabled = false;

      recordBtn.textContent =
        '🎤 Gravar Áudio';

    }

  });



  // ── Gravação de áudio no chat ─────────────────────────────

  chatRecordBtn.addEventListener('click', async () => {

    chatRecordBtn.disabled = true;

    chatRecordBtn.textContent = '🎙️';


    try {

      const stream =
        await navigator.mediaDevices.getUserMedia({
          audio: true
        });


      currentStream = stream;


      const mediaRecorder =
        new MediaRecorder(stream);


      const chunks = [];


      mediaRecorder.ondataavailable =
        e => chunks.push(e.data);



      mediaRecorder.onstop = async () => {


        try {

          if (currentStream) {

            currentStream
              .getTracks()
              .forEach(t => t.stop());

            currentStream = null;

          }

        } catch (e) {}



        const blob =
          new Blob(
            chunks,
            {
              type: 'audio/webm'
            }
          );


        const formData =
          new FormData();


        formData.append(
          'file',
          blob,
          'chat_recording.webm'
        );


        appendMessage(
          'Enviando áudio para transcrição...',
          'bot'
        );


        let response;


        try {

          response =
            await fetch(
              `${API_BASE}/api/transcrever`,
              {
                method: 'POST',
                body: formData
              }
            );


        } catch (err) {

          appendMessage(
            'Erro de rede ao enviar áudio.',
            'bot'
          );

          chatRecordBtn.disabled = false;

          chatRecordBtn.textContent =
            '🎤';

          return;

        }



        if (!response.ok) {

          appendMessage(
            'Erro ao transcrever (status ' +
            response.status +
            ')',
            'bot'
          );

          chatRecordBtn.disabled = false;

          chatRecordBtn.textContent =
            '🎤';

          return;

        }



        let data;


        try {

          data =
            await response.json();

        } catch (err) {

          appendMessage(
            'Resposta inválida do servidor.',
            'bot'
          );

          chatRecordBtn.disabled = false;

          chatRecordBtn.textContent =
            '🎤';

          return;

        }



        // A API retorna texto_transcrito
        if (data.texto_transcrito) {


          homeContent.style.display =
            'none';


          chatWrapper.style.display =
            'block';


          chatInput.value =
            data.texto_transcrito;


          appendMessage(
            `Transcrição: "${data.texto_transcrito}"`,
            'bot'
          );


          setTimeout(() => {

            chatForm.dispatchEvent(
              new Event('submit')
            );

          }, 100);


        } else {


          appendMessage(
            data.mensagem ||
            'Não foi possível transcrever o áudio.',
            'bot'
          );

        }



        chatRecordBtn.disabled = false;

        chatRecordBtn.textContent =
          '🎤';

      };



      mediaRecorder.start();


      appendMessage(
        '🎤 Gravando áudio por 5 segundos...',
        'bot'
      );


      setTimeout(() => {

        if (
          mediaRecorder.state !==
          'inactive'
        ) {

          mediaRecorder.stop();

        }

      }, 5000);



    } catch (err) {


      appendMessage(
        'Permissão negada ou erro ao acessar microfone.',
        'bot'
      );


      chatRecordBtn.disabled = false;

      chatRecordBtn.textContent =
        '🎤';

    }

  });



  // ── Tradução automática pela URL ──────────────────────────

  let autoTraducaoExecutada = false;


  window.addEventListener(
    'DOMContentLoaded',
    () => {

      if (autoTraducaoExecutada) {
        return;
      }


      const params =
        new URLSearchParams(
          window.location.search
        );


      const word =
        params.get('word');


      if (word) {


        autoTraducaoExecutada = true;


        document.getElementById(
          'input_text'
        ).value = word;


        document.getElementById(
          'searchForm'
        ).dispatchEvent(
          new Event('submit')
        );

      }

    }
  );

</script>
</main>
</body>
