<%- include('includes/head'); %>
<%- include('includes/navbar'); %>

<!-- Modal de Vídeo Tutorial -->
<div class="tutorial-overlay" id="tutorialOverlay" role="dialog" aria-modal="true" aria-labelledby="tutorialTitulo">
  <div class="tutorial-modal">
    <div class="tutorial-modal-header">
      <span id="tutorialTitulo">📹 Vídeo Tutorial</span>
      <button class="tutorial-close" id="tutorialClose" aria-label="Fechar tutorial">✕</button>
    </div>
    <div class="tutorial-video-wrap">
      <video id="tutorialVideo" controls playsinline></video>
    </div>
    <p class="tutorial-caption">Aprenda a usar o TraduLibras em poucos minutos.</p>
  </div>
</div>

<!-- Tela inicial (mesmo padrão de Cursos e Planos) -->
<main class="planos-container tradutor-pagina" id="inicio">
  <div class="planos-cabecalho">
    <h1 class="planos-titulo">Tradutor</h1>
    <p class="planos-subtitulo">Escreva ou fale em português e veja a frase em Libras, sinal por sinal.</p>
    <button type="button" class="tradutor-tutorial" data-tutorial>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/>
      </svg>
      Como usar (vídeo tutorial)
    </button>
  </div>

  <section class="tradutor-caixa" aria-label="Traduzir para Libras">
    <form id="searchForm" class="tradutor-form">
      <label for="input_text" class="tradutor-rotulo">Palavra ou frase em português</label>
      <div class="tradutor-linha">
        <input type="text" class="input-home tradutor-input" id="input_text" name="input_text"
               placeholder="Ex.: bom dia, tudo bem?" maxlength="300" autocomplete="off" enterkeyhint="go"
               aria-describedby="tradutorDica">
        <button type="button" class="plano-botao plano-botao-secundario btn-falar" id="recordBtn" aria-label="Falar: grava sua voz por até 5 segundos">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="17" x2="12" y2="22"/>
          </svg>
          Falar
        </button>
        <button type="submit" class="plano-botao btn-traduzir" id="searchSubmit">
          Traduzir
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
      <p class="tradutor-dica" id="tradutorDica">Frases curtas funcionam melhor. Nomes próprios são soletrados letra por letra.</p>
      <p class="tradutor-status" id="tradutorStatus" role="status" aria-live="polite"></p>
    </form>

    <div class="tradutor-exemplos" role="group" aria-label="Exemplos para experimentar">
      <span class="tradutor-exemplos-rotulo">Experimente:</span>
      <% ['bom dia', 'eu te amo', 'obrigado', 'qual é o seu nome?', 'meu nome é Ana'].forEach((exemplo) => { %>
        <button type="button" class="curso-chip" data-exemplo="<%= exemplo %>"><%= exemplo %></button>
      <% }); %>
    </div>
  </section>

  <div class="buttons-cards">
    <a href="#input_text" class="card-traduzir" id="cardTraduzir">
      <p class="icon-traduzir" aria-hidden="true">🔁</p>
      <h2 class="title-card">Traduzir</h2>
      <p class="descricao-card">Converta palavras em Libras de forma rápida e intuitiva.</p>
    </a>
    <a href="/cursos" class="card-aprender">
      <p class="icon-aprender" aria-hidden="true">📖</p>
      <h2 class="title-card">Aprender</h2>
      <p class="descricao-card">Descubra novos sinais e amplie seu conhecimento em Libras.</p>
    </a>
    <a href="/sugestoes" class="card-incluir">
      <p class="icon-incluir" aria-hidden="true">🤗</p>
      <h2 class="title-card">Incluir</h2>
      <p class="descricao-card">Facilite a comunicação e torne o diálogo mais acessível.</p>
    </a>
  </div>
</main>

<!-- Conversa (estilo WhatsApp): abre na primeira tradução -->
<section class="conversa" id="conversa" aria-labelledby="conversaNome" hidden>
  <header class="conversa-topo">
    <span class="conversa-avatar" aria-hidden="true">🤟</span>
    <div class="conversa-info">
      <h1 class="conversa-nome" id="conversaNome">TraduLibras</h1>
      <p class="conversa-status" id="conversaStatus">online</p>
    </div>
    <div class="conversa-acoes">
      <button type="button" class="conversa-icone" data-tutorial aria-label="Ver o vídeo tutorial" title="Tutorial">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>
      </button>
      <button type="button" class="conversa-icone" id="btnLimpar" aria-label="Nova conversa: apaga as mensagens e volta ao início" title="Nova conversa">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>
      </button>
    </div>
  </header>

  <div class="conversa-mensagens" id="listaMensagens" aria-label="Mensagens">
    <div class="conversa-dia"><span>Hoje</span></div>
  </div>

  <form class="conversa-rodape" id="chatForm">
    <div class="conversa-campo" id="conversaCampo">
      <label for="chat_input" class="sr-only">Frase para traduzir</label>
      <input type="text" class="conversa-input" id="chat_input" name="chat_input" placeholder="Digite uma frase"
             maxlength="300" autocomplete="off" enterkeyhint="send">
      <p class="conversa-gravando" id="conversaGravando" hidden>
        <span class="conversa-gravando-ponto" aria-hidden="true"></span>
        <span id="conversaGravandoTexto">Gravando… 0:05</span>
      </p>
    </div>
    <button type="button" class="conversa-botao" id="chatAcao" aria-label="Gravar áudio">
      <svg class="icone-mic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="17" x2="12" y2="22"/>
      </svg>
      <svg class="icone-enviar" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 21 12 3.4 3.6l-.01 6.53L15 12 3.39 13.87z"/></svg>
      <svg class="icone-parar" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
    </button>
  </form>
</section>

<p class="sr-only" id="anuncio" aria-live="polite"></p>

<%# Sinais que o usuário logado marcou como incorretos (JSON seguro para <script>) %>
<script type="application/json" id="dadosExclusoes"><%- JSON.stringify(typeof exclusoes !== 'undefined' ? exclusoes : []).replace(/</g, '\\u003c') %></script>

<script>
(() => {
  'use strict';

  // ── Configuração ──────────────────────────────────────────
  // Em localhost a API Python roda separada na porta 5000; no servidor, /api é repassado pelo proxy
  const API_BASE = ['localhost', '127.0.0.1'].includes(window.location.hostname)
    ? 'http://localhost:5000'
    : '';
  const USUARIO_LOGADO = <%= (typeof user !== 'undefined' && user) ? 'true' : 'false' %>;
  const CSRF_TOKEN = document.querySelector('meta[name="csrf-token"]')?.content || '';
  const TEMPO_LIMITE_MS = 30000;
  const DURACAO_GRAVACAO_MS = 5000;
  const LIMITE_TEXTO = 300;
  const VELOCIDADES = [0.5, 0.75, 1];
  const CHAVE_VELOCIDADE = 'tradulibras:velocidade';

  // ── Elementos ─────────────────────────────────────────────
  const inicio       = document.getElementById('inicio');
  const conversa     = document.getElementById('conversa');
  const searchForm   = document.getElementById('searchForm');
  const searchInput  = document.getElementById('input_text');
  const recordBtn    = document.getElementById('recordBtn');
  const statusInicio = document.getElementById('tradutorStatus');
  const lista        = document.getElementById('listaMensagens');
  const chatForm     = document.getElementById('chatForm');
  const chatInput    = document.getElementById('chat_input');
  const chatAcao     = document.getElementById('chatAcao');
  const statusTopo   = document.getElementById('conversaStatus');
  const gravandoEl   = document.getElementById('conversaGravando');
  const gravandoTxt  = document.getElementById('conversaGravandoTexto');
  const anuncio      = document.getElementById('anuncio');
  const exemplos     = [...document.querySelectorAll('[data-exemplo]')];

  let traduzindo = false;
  let gravando = false;
  let playerAtivo = null;
  const players = new Set();
  const audiosGravados = [];

  let velocidade = 1;
  try {
    const salva = Number(localStorage.getItem(CHAVE_VELOCIDADE));
    if (VELOCIDADES.includes(salva)) velocidade = salva;
  } catch (e) { /* armazenamento indisponível */ }

  // ── Sinais ocultados (resultado do feedback negativo) ─────
  // Logado: vêm do banco e valem em qualquer dispositivo.
  // Visitante: ficam só nesta aba do navegador (sessionStorage) e somem ao fechá-la.
  // Nos dois casos são enviados junto com cada tradução e só mudam o resultado de quem votou.
  const CHAVE_SESSAO = 'tradulibras:sinaisOcultos';
  const exclusoes = new Map();
  const normalizar = (t) => String(t || '').replace(/\s+/g, ' ').trim().toLowerCase();

  function guardarExclusoes(listaNova) {
    (listaNova || []).forEach((item) => {
      const termo = normalizar(item.termo);
      const expressao = normalizar(item.expressao);
      if (termo && expressao) exclusoes.set(`${termo}\u0000${expressao}`, { termo, expressao });
    });
  }
  const listaExclusoes = () => [...exclusoes.values()];

  if (USUARIO_LOGADO) {
    try { guardarExclusoes(JSON.parse(document.getElementById('dadosExclusoes').textContent)); } catch (e) { /* sem dados */ }
  } else {
    try { guardarExclusoes(JSON.parse(sessionStorage.getItem(CHAVE_SESSAO) || '[]')); } catch (e) { /* armazenamento indisponível */ }
  }

  function salvarNaSessao() {
    try { sessionStorage.setItem(CHAVE_SESSAO, JSON.stringify(listaExclusoes())); } catch (e) { /* armazenamento indisponível */ }
  }

  // ── Vídeo tutorial ────────────────────────────────────────
  const TUTORIAL_URL = 'https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/tutorial_tradulibras_com_som.mp4';
  const tutorialOverlay = document.getElementById('tutorialOverlay');
  const tutorialVideo   = document.getElementById('tutorialVideo');

  function abrirTutorial() {
    if (playerAtivo) playerAtivo.pausar();
    tutorialVideo.src = TUTORIAL_URL;
    tutorialVideo.load();
    tutorialVideo.play().catch(() => {});
    tutorialOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  document.querySelectorAll('[data-tutorial]').forEach((b) => b.addEventListener('click', abrirTutorial));
  // /home?tutorial=1 (link "Ver tutorial" da página Ajuda) já abre o vídeo
  if (new URLSearchParams(window.location.search).get('tutorial') === '1') abrirTutorial();

  function fecharTutorial() {
    if (!tutorialOverlay.classList.contains('open')) return;
    tutorialOverlay.classList.remove('open');
    tutorialVideo.pause();
    tutorialVideo.removeAttribute('src');
    tutorialVideo.load();
    document.body.style.overflow = '';
  }
  document.getElementById('tutorialClose').addEventListener('click', fecharTutorial);
  tutorialOverlay.addEventListener('click', (e) => { if (e.target === tutorialOverlay) fecharTutorial(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fecharTutorial(); });

  // ── Utilitários de DOM (sempre textContent: nada de HTML vindo do usuário/API) ──
  function criar(tag, { classe, texto, atributos } = {}, filhos = []) {
    const elemento = document.createElement(tag);
    if (classe) elemento.className = classe;
    if (texto !== undefined) elemento.textContent = texto;
    if (atributos) Object.entries(atributos).forEach(([k, v]) => elemento.setAttribute(k, v));
    filhos.forEach((filho) => elemento.append(filho));
    return elemento;
  }

  const anunciar = (texto) => { anuncio.textContent = ''; setTimeout(() => { anuncio.textContent = texto; }, 50); };
  const horaAgora = () => new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });

  // ── Estado da conversa ────────────────────────────────────
  function abrirConversa() {
    if (!conversa.hidden) return;
    inicio.hidden = true;
    conversa.hidden = false;
    document.body.classList.add('em-conversa');
    window.scrollTo(0, 0);
  }

  function definirStatus(texto) { statusTopo.textContent = texto; }

  function atualizarBloqueios() {
    const ocupado = traduzindo || gravando;
    exemplos.forEach((b) => { b.disabled = ocupado; });
    document.getElementById('searchSubmit').disabled = ocupado;
    recordBtn.disabled = ocupado;
    chatAcao.disabled = traduzindo && !gravando;
    if (gravando) definirStatus('gravando áudio…');
    else if (traduzindo) definirStatus('traduzindo…');
    else definirStatus('online');
  }

  // Botão redondo do rodapé: microfone com o campo vazio, "enviar" quando há texto, "parar" gravando
  function atualizarBotaoChat() {
    const modo = gravando ? 'parar' : (chatInput.value.trim() ? 'enviar' : 'mic');
    chatAcao.dataset.modo = modo;
    chatAcao.setAttribute('aria-label', { parar: 'Parar e enviar o áudio', enviar: 'Traduzir', mic: 'Gravar áudio' }[modo]);
    chatAcao.type = modo === 'enviar' ? 'submit' : 'button';
  }
  chatInput.addEventListener('input', atualizarBotaoChat);

  // Rola para mostrar a mensagem nova (se for alta, mostra o começo dela)
  function rolarPara(elemento) {
    requestAnimationFrame(() => {
      const alta = elemento.offsetHeight > lista.clientHeight - 24;
      lista.scrollTop = alta ? elemento.offsetTop - 12 : lista.scrollHeight;
    });
  }

  function rodape(extra = []) {
    return criar('span', { classe: 'msg-rodape' }, [criar('time', { texto: horaAgora() }), ...extra]);
  }

  // Mensagem do usuário (direita). Os tiques viram ✓✓ quando a resposta chega.
  function mensagemUsuario(conteudo) {
    const tiques = criar('span', { classe: 'msg-tiques', texto: '✓', atributos: { 'aria-hidden': 'true' } });
    const balao = criar('div', { classe: 'msg msg-usuario' }, [...conteudo, rodape([tiques])]);
    lista.append(balao);
    rolarPara(balao);
    return {
      balao,
      respondida() { tiques.textContent = '✓✓'; tiques.classList.add('lida'); },
    };
  }

  // Resposta do TraduLibras (esquerda)
  function mensagemBot() {
    const balao = criar('div', { classe: 'msg msg-bot digitando' }, [
      criar('span', { classe: 'carregando-pontos', atributos: { 'aria-label': 'Traduzindo' } }, [criar('span'), criar('span'), criar('span')]),
    ]);
    lista.append(balao);
    rolarPara(balao);
    return {
      balao,
      erro(conteudo) {
        balao.className = 'msg msg-bot erro';
        balao.replaceChildren(
          criar('p', { classe: 'msg-texto' }, [criar('span', { texto: '⚠️ ', atributos: { 'aria-hidden': 'true' } }), conteudo]),
          rodape(),
        );
        rolarPara(balao);
      },
      mostrar(elementos) {
        balao.className = 'msg msg-bot msg-traducao';
        balao.replaceChildren(...elementos, rodape());
        rolarPara(balao);
      },
    };
  }

  function limparConversa() {
    players.forEach((p) => p.pausar());
    players.clear();
    playerAtivo = null;
    audiosGravados.splice(0).forEach((url) => URL.revokeObjectURL(url));
    lista.replaceChildren(criar('div', { classe: 'conversa-dia' }, [criar('span', { texto: 'Hoje' })]));
    conversa.hidden = true;
    inicio.hidden = false;
    document.body.classList.remove('em-conversa');
    searchInput.focus();
  }
  document.getElementById('btnLimpar').addEventListener('click', () => {
    if (lista.querySelector('.msg') && !window.confirm('Apagar esta conversa e voltar ao início?')) return;
    limparConversa();
  });

  // "Traduzir" nos atalhos leva ao campo, em vez de recarregar a página
  document.getElementById('cardTraduzir').addEventListener('click', (e) => {
    e.preventDefault();
    searchInput.focus();
    searchInput.scrollIntoView({ block: 'center' });
  });

  // ── Chamada à API com tempo limite ────────────────────────
  async function chamarApi(caminho, opcoes) {
    const controle = new AbortController();
    const timer = setTimeout(() => controle.abort(), TEMPO_LIMITE_MS);
    try {
      const resposta = await fetch(`${API_BASE}${caminho}`, { ...opcoes, signal: controle.signal });
      let dados = null;
      try { dados = await resposta.json(); } catch (e) { dados = null; }
      return { ok: resposta.ok, status: resposta.status, dados };
    } catch (erro) {
      return { ok: false, status: 0, dados: null, tipo: erro.name === 'AbortError' ? 'tempo' : 'rede' };
    } finally {
      clearTimeout(timer);
    }
  }

  // Mensagens claras para cada tipo de falha
  function mensagemDeErro(resultado) {
    const { status, dados, tipo } = resultado;
    if (tipo === 'tempo') return 'A tradução está demorando mais que o normal. Tente novamente em instantes.';
    if (tipo === 'rede') return 'Não foi possível conectar ao serviço de tradução. Verifique sua conexão e tente novamente.';
    if (status === 404 && dados && dados.codigo === 'SEM_SINAIS') {
      const partes = ['Ainda não temos sinais para essa frase. '];
      if (Array.isArray(dados.sem_sinal) && dados.sem_sinal.length) partes.push(`Sem sinal: ${dados.sem_sinal.join(', ')}. `);
      partes.push('Veja as palavras disponíveis no ', criar('a', { texto: 'Glossário', atributos: { href: dados.sugestao_link || '/sugestoes' } }), '.');
      return criar('span', {}, partes);
    }
    if (status >= 500 || !dados) return 'O serviço de tradução está com problemas agora. Tente novamente em alguns minutos.';
    return dados.mensagem || 'Não foi possível processar o pedido.';
  }

  // ── Sinais da resposta ────────────────────────────────────
  // Explica quando o sinal não é a palavra exata digitada
  function notaDoSinal(item) {
    const termo = item.termo_original || '';
    if (item.metodo === 'datilologia') return `soletrando “${termo}”`;
    if (item.aproximado) return `sinal aproximado para “${termo}”`;
    if (item.metodo === 'correcao') return `você escreveu “${termo}”`;
    if (['sinonimo', 'variacao', 'lema'].includes(item.metodo) && normalizar(termo) !== normalizar(item.expressao_libras)) {
      return `para “${termo}”`;
    }
    return '';
  }

  // Um item por sinal; letras soletradas seguidas da mesma palavra viram um item só ("A-N-A")
  function agruparSinais(sequencia) {
    const grupos = [];
    sequencia.forEach((item, i) => {
      const nome = String(item.expressao_libras || item.termo_original || '').toUpperCase();
      const anterior = grupos[grupos.length - 1];
      if (item.metodo === 'datilologia' && anterior && anterior.soletrado && anterior.termo === item.termo_original) {
        anterior.fim = i;
        anterior.rotulo += `-${nome}`;
        return;
      }
      grupos.push({
        inicio: i, fim: i, rotulo: nome, termo: item.termo_original,
        soletrado: item.metodo === 'datilologia', aproximado: Boolean(item.aproximado), nota: notaDoSinal(item),
      });
    });
    return grupos;
  }

  // ── Player dos sinais ─────────────────────────────────────
  // Dois <video> alternados: enquanto um toca, o outro já carrega o próximo sinal (sem pausa entre sinais).
  // A sequência toca uma vez; depois aparece "Repetir". Clicar num sinal da lista toca a partir dele.
  function criarPlayer({ palco, legenda, botaoPausa, botaoRepetir, chips, grupos, sequencia }) {
    let [atual, proximo] = palco.querySelectorAll('video');
    const total = sequencia.length;
    let indice = 0;
    let terminou = false;

    const grupoDoIndice = (i) => grupos.findIndex((g) => i >= g.inicio && i <= g.fim);

    function aplicarVelocidade(video) {
      video.defaultPlaybackRate = velocidade;
      video.playbackRate = velocidade;
    }

    function carregar(video, i) {
      if (video.dataset.indice === String(i)) return;
      video.dataset.indice = String(i);
      video.src = sequencia[i].url;
      video.load();
      aplicarVelocidade(video);
    }

    function atualizarLegenda(i) {
      const g = grupoDoIndice(i);
      const grupo = grupos[g];
      const partes = [`Sinal ${g + 1} de ${grupos.length}: `, criar('strong', { texto: grupo.rotulo })];
      if (grupo.nota) partes.push(criar('span', { classe: 'termo-nota', texto: ` (${grupo.nota})` }));
      legenda.replaceChildren(...partes);
      chips.forEach((chip, k) => {
        if (k === g) chip.setAttribute('aria-current', 'step');
        else chip.removeAttribute('aria-current');
      });
    }

    function tocar(i) {
      indice = i;
      terminou = false;
      botaoRepetir.hidden = true;
      botaoPausa.hidden = false;
      botaoPausa.textContent = '⏸ Pausar';
      carregar(atual, i);
      atual.classList.add('is-visible');
      proximo.classList.remove('is-visible');
      atualizarLegenda(i);
      aplicarVelocidade(atual);
      atual.play().catch((erro) => {
        // Navegador bloqueou o autoplay: o usuário inicia pelo botão.
        // (AbortError = o usuário pausou antes de o vídeo carregar; o botão já mostra "Continuar")
        if (erro && erro.name === 'NotAllowedError') botaoPausa.textContent = '▶ Reproduzir';
      });
      if (i + 1 < total) carregar(proximo, i + 1);
    }

    function avancar(evento) {
      if (evento.target !== atual) return;
      if (indice + 1 < total) {
        [atual, proximo] = [proximo, atual];
        tocar(indice + 1);
      } else {
        terminou = true;
        botaoPausa.hidden = true;
        botaoRepetir.hidden = false;
      }
    }

    [atual, proximo].forEach((video) => {
      video.addEventListener('ended', avancar);
      video.addEventListener('error', avancar); // vídeo indisponível: pula para o próximo sinal
    });

    const controle = {
      iniciar() { tocar(0); },
      pausar() {
        atual.pause();
        if (!terminou) botaoPausa.textContent = '▶ Continuar';
      },
      alternar() {
        if (atual.paused) {
          ativar(controle);
          atual.play().catch(() => {});
          botaoPausa.textContent = '⏸ Pausar';
        } else {
          controle.pausar();
        }
      },
      irPara(i) {
        ativar(controle);
        // garante que o sinal escolhido seja recarregado no player visível
        atual.dataset.indice = '';
        tocar(i);
      },
      repetir() { controle.irPara(0); },
      velocidade() { aplicarVelocidade(atual); aplicarVelocidade(proximo); },
    };

    botaoPausa.addEventListener('click', () => controle.alternar());
    botaoRepetir.addEventListener('click', () => controle.repetir());
    chips.forEach((chip, k) => chip.addEventListener('click', () => controle.irPara(grupos[k].inicio)));
    palco.addEventListener('click', () => (terminou ? controle.repetir() : controle.alternar()));
    players.add(controle);
    return controle;
  }

  // Só um player toca por vez: ao iniciar um, o anterior é pausado
  function ativar(player) {
    if (playerAtivo && playerAtivo !== player) playerAtivo.pausar();
    playerAtivo = player;
  }

  // Velocidade: vale para todos os vídeos e fica guardada no navegador
  function seletorVelocidade() {
    const opcoes = VELOCIDADES.map((v) => {
      const botao = criar('button', {
        classe: 'ciclo-opcao',
        texto: `${String(v).replace('.', ',')}×`,
        atributos: { type: 'button', 'data-velocidade': String(v), 'aria-pressed': String(v === velocidade) },
      });
      botao.addEventListener('click', () => {
        velocidade = v;
        try { localStorage.setItem(CHAVE_VELOCIDADE, String(v)); } catch (e) { /* armazenamento indisponível */ }
        document.querySelectorAll('[data-velocidade]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.velocidade) === v)));
        players.forEach((p) => p.velocidade());
      });
      return botao;
    });
    return criar('div', { classe: 'ciclo-seletor velocidade', atributos: { role: 'group', 'aria-label': 'Velocidade dos vídeos', title: 'Velocidade' } }, opcoes);
  }

  // Palavras que ficaram de fora (sem sinal confiável no banco): melhor avisar do que mostrar um sinal errado
  function avisoSemSinal(termos) {
    if (!Array.isArray(termos) || termos.length === 0) return [];
    return [criar('p', { classe: 'traducao-sem-sinal' }, [
      criar('strong', { texto: 'Ainda sem sinal: ' }),
      termos.join(', '),
      '. ',
      criar('a', { texto: 'Sugerir', atributos: { href: '/sugestoes' } }),
    ])];
  }

  // ── Resposta da tradução (balão com vídeo) ────────────────
  function renderTraducao(resposta, dados, entrada) {
    const sequencia = dados.sequencia || [];
    const grupos = agruparSinais(sequencia);

    const palco = criar('div', { classe: 'video-stage', atributos: { title: 'Toque para pausar ou continuar' } }, [
      criar('video', { classe: 'video-libras', atributos: { muted: '', playsinline: '', preload: 'auto', 'aria-label': 'Vídeo do sinal em Libras' } }),
      criar('video', { classe: 'video-libras', atributos: { muted: '', playsinline: '', preload: 'auto', 'aria-hidden': 'true' } }),
    ]);
    palco.querySelectorAll('video').forEach((v) => { v.muted = true; });

    const legenda = criar('p', { classe: 'termo-atual', atributos: { 'aria-live': 'polite' } });
    const botaoPausa = criar('button', { classe: 'btn-player', texto: '⏸ Pausar', atributos: { type: 'button' } });
    const botaoRepetir = criar('button', { classe: 'btn-player btn-player-primario', texto: '↻ Repetir', atributos: { type: 'button' } });
    botaoRepetir.hidden = true;

    const chips = grupos.map((g, k) => criar('button', {
      classe: `sinal-chip${g.aproximado ? ' aproximado' : ''}`,
      atributos: { type: 'button', title: g.nota ? `${g.rotulo}: ${g.nota}` : `Ver o sinal ${g.rotulo}` },
    }, [criar('span', { classe: 'sinal-num', texto: String(k + 1), atributos: { 'aria-hidden': 'true' } }), g.rotulo]));

    // Com um sinal só, a legenda embaixo do vídeo já explica; a lista de notas seria repetição
    const notas = grupos.length > 1 ? grupos.filter((g) => g.nota) : [];

    resposta.mostrar([
      palco,
      legenda,
      criar('div', { classe: 'player-barra' }, [
        criar('div', { classe: 'player-controles' }, [botaoPausa, botaoRepetir]),
        seletorVelocidade(),
      ]),
      criar('div', { classe: 'sinais-sequencia', atributos: { role: 'group', 'aria-label': 'Sinais da tradução, na ordem da Libras: escolha um para ver' } }, chips),
      ...(notas.length
        ? [criar('ul', { classe: 'traducao-notas' }, notas.map((g) => criar('li', {}, [criar('strong', { texto: g.rotulo }), ` — ${g.nota}`])))]
        : []),
      ...avisoSemSinal(dados.sem_sinal),
      criarFeedback({ texto: entrada, glosa: dados.glosa || '', sequencia }),
    ]);

    const player = criarPlayer({ palco, legenda, botaoPausa, botaoRepetir, chips, grupos, sequencia });
    ativar(player);
    player.iniciar();
    anunciar(`Tradução pronta: ${grupos.length} ${grupos.length === 1 ? 'sinal' : 'sinais'}.`);
  }

  // ── Feedback ──────────────────────────────────────────────
  // 👍 registra que a tradução ajudou. 👎 pergunta qual sinal estava errado:
  // os sinais marcados deixam de ser usados nas próximas traduções DESTE usuário.
  async function enviarFeedbackServidor(corpo) {
    try {
      const resposta = await fetch('/feedback', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
        body: JSON.stringify(corpo),
      });
      const dados = await resposta.json().catch(() => null);
      return { ok: resposta.ok, status: resposta.status, dados };
    } catch (e) {
      return { ok: false, status: 0, dados: null };
    }
  }

  function avisoSessao() {
    return criar('span', { classe: 'feedback-aviso' }, [
      'Como você não entrou na sua conta, isso vale só nesta sessão. ',
      criar('a', { texto: 'Entrar', atributos: { href: '/login' } }),
      ' ou ',
      criar('a', { texto: 'criar conta', atributos: { href: '/register' } }),
      ' para guardar.',
    ]);
  }

  function criarFeedback({ texto, glosa, sequencia }) {
    const pergunta = criar('span', { classe: 'feedback-pergunta', texto: 'Esse era o resultado esperado?' });
    const sim = criar('button', { classe: 'feedback-botao', atributos: { type: 'button', 'aria-label': 'Sim, era o esperado' } }, ['👍 ', criar('span', { texto: 'Sim' })]);
    const nao = criar('button', { classe: 'feedback-botao', atributos: { type: 'button', 'aria-label': 'Não era o esperado', 'aria-expanded': 'false' } }, ['👎 ', criar('span', { texto: 'Não' })]);
    const linha = criar('div', { classe: 'feedback-inline' }, [pergunta, criar('span', { classe: 'feedback-botoes' }, [sim, nao])]);

    // Sinais da resposta, sem repetição, na mesma ordem do player
    const vistos = new Set();
    const sinais = [];
    sequencia.forEach((item, i) => {
      if (item.metodo === 'datilologia') return; // letras soletradas não são "sinal errado"
      const termo = normalizar(item.termo_original);
      const expressao = normalizar(item.expressao_libras);
      const chave = `${termo}\u0000${expressao}`;
      if (!termo || !expressao || vistos.has(chave)) return;
      vistos.add(chave);
      sinais.push({ termo, expressao, rotulo: `${i + 1}. ${item.expressao_libras}` });
    });

    const chips = sinais.map((s) => {
      const chip = criar('button', {
        classe: 'feedback-chip',
        texto: s.rotulo,
        atributos: { type: 'button', 'aria-pressed': 'false', title: `Termo da glosa: ${s.termo}` },
      });
      chip.addEventListener('click', () => {
        const marcado = chip.getAttribute('aria-pressed') !== 'true';
        chip.setAttribute('aria-pressed', String(marcado));
        enviarDetalhe.textContent = marcado || chips.some((c) => c.getAttribute('aria-pressed') === 'true')
          ? 'Enviar' : 'Enviar sem marcar';
      });
      return chip;
    });
    const enviarDetalhe = criar('button', { classe: 'btn-player btn-player-primario', texto: 'Enviar sem marcar', atributos: { type: 'button' } });
    const cancelar = criar('button', { classe: 'btn-player', texto: 'Cancelar', atributos: { type: 'button' } });
    const detalhe = criar('div', { classe: 'feedback-detalhe' }, [
      criar('p', { texto: 'Qual sinal não ficou certo? Toque para marcar:' }),
      criar('div', { classe: 'feedback-sinais' }, chips),
      criar('div', { classe: 'feedback-acoes' }, [enviarDetalhe, cancelar]),
    ]);
    detalhe.hidden = true;

    const status = criar('div', { classe: 'feedback-status', atributos: { role: 'status' } });
    const caixa = criar('div', { classe: 'feedback-caixa' }, [linha, detalhe, status]);

    function bloquear(sim_) { [sim, nao, enviarDetalhe, cancelar, ...chips].forEach((b) => { b.disabled = sim_; }); }

    function concluir(foiUtil, marcados) {
      linha.hidden = true;
      detalhe.hidden = true;
      const partes = [];
      if (foiUtil) {
        partes.push(criar('p', { texto: 'Obrigado! Que bom que a tradução ajudou. 💙' }));
      } else if (marcados.length > 0) {
        const nomes = marcados.map((s) => s.expressao.toUpperCase()).join(', ');
        partes.push(criar('p', {
          texto: marcados.length === 1
            ? `Entendido. Nas suas próximas traduções não vamos mais usar o sinal ${nomes}.`
            : `Entendido. Nas suas próximas traduções não vamos mais usar os sinais ${nomes}.`,
        }));
        const repetir = criar('button', { classe: 'btn-player btn-player-primario', texto: '↻ Traduzir de novo', atributos: { type: 'button' } });
        repetir.addEventListener('click', () => traduzirTexto(texto));
        partes.push(repetir);
      } else {
        partes.push(criar('p', { texto: 'Obrigado pelo retorno! Ele nos ajuda a melhorar as traduções.' }));
      }
      if (USUARIO_LOGADO && !foiUtil && marcados.length > 0) {
        partes.push(criar('span', { classe: 'feedback-aviso' }, [
          'Você pode desfazer isso em ', criar('a', { texto: 'Histórico', atributos: { href: '/historico#sinais-ocultos' } }), '.',
        ]));
      }
      if (!USUARIO_LOGADO) partes.push(avisoSessao());
      status.replaceChildren(...partes);
    }

    async function enviar(foiUtil, marcados = []) {
      if (!USUARIO_LOGADO) {
        guardarExclusoes(marcados);
        salvarNaSessao();
        return concluir(foiUtil, marcados);
      }

      bloquear(true);
      status.textContent = 'Enviando…';
      const r = await enviarFeedbackServidor({
        texto,
        glosa,
        foi_util: foiUtil,
        sinais_incorretos: marcados.map(({ termo, expressao }) => ({ termo, expressao })),
      });
      if (r.ok) {
        guardarExclusoes(r.dados?.exclusoes || marcados);
        return concluir(foiUtil, marcados);
      }
      bloquear(false);
      status.textContent = r.status === 401 || r.status === 403
        ? 'Sua sessão expirou. Recarregue a página e tente novamente.'
        : (r.dados?.mensagem || 'Não foi possível enviar o feedback agora. Tente novamente.');
    }

    sim.addEventListener('click', () => enviar(true));
    nao.addEventListener('click', () => {
      if (sinais.length === 0) return enviar(false);
      const abrir = detalhe.hidden;
      detalhe.hidden = !abrir;
      nao.setAttribute('aria-expanded', String(abrir));
      if (abrir) chips[0].focus();
    });
    cancelar.addEventListener('click', () => {
      detalhe.hidden = true;
      nao.setAttribute('aria-expanded', 'false');
      nao.focus();
    });
    enviarDetalhe.addEventListener('click', () => {
      const marcados = sinais.filter((_, i) => chips[i].getAttribute('aria-pressed') === 'true');
      enviar(false, marcados);
    });
    return caixa;
  }

  // ── Histórico (somente usuário logado; visitantes veem o convite em /historico) ──
  // Salva a tradução no histórico. Se falhar, a tradução continua normalmente.
  function salvarHistorico(texto, glosa, sequencia) {
    if (!USUARIO_LOGADO || !texto) return;
    fetch('/historico', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
      body: JSON.stringify({
        texto,
        glosa: glosa || '',
        sequencia: (sequencia || []).map((item) => ({
          termo_original: item.termo_original,
          expressao_libras: item.expressao_libras,
          url: item.url,
        })),
      }),
    }).catch((err) => console.warn('Não foi possível salvar no histórico:', err));
  }

  function tratarResultadoTraducao(resposta, resultado, entrada) {
    const { ok, dados } = resultado;
    if (ok && dados && dados.status === 'success' && (dados.sequencia || []).length > 0) {
      renderTraducao(resposta, dados, entrada);
      salvarHistorico(entrada, dados.glosa, dados.sequencia);
    } else {
      const mensagem = mensagemDeErro(resultado);
      resposta.erro(mensagem);
      anunciar(typeof mensagem === 'string' ? mensagem : mensagem.textContent);
    }
  }

  // ── Tradução por texto ────────────────────────────────────
  async function traduzirTexto(textoBruto) {
    const texto = (textoBruto || '').trim().slice(0, LIMITE_TEXTO);
    if (!texto || traduzindo || gravando) return;

    abrirConversa();
    searchInput.value = '';
    chatInput.value = '';
    statusInicio.textContent = '';
    atualizarBotaoChat();

    const enviada = mensagemUsuario([criar('p', { classe: 'msg-texto', texto })]);
    const resposta = mensagemBot();
    traduzindo = true;
    atualizarBloqueios();
    try {
      const resultado = await chamarApi('/api/sugestao', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ texto, exclusoes: listaExclusoes() }),
      });
      enviada.respondida();
      tratarResultadoTraducao(resposta, resultado, texto);
    } finally {
      traduzindo = false;
      atualizarBloqueios();
      chatInput.focus({ preventScroll: true });
    }
  }

  searchForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!searchInput.value.trim()) {
      statusInicio.textContent = 'Digite uma palavra ou frase para traduzir.';
      searchInput.focus();
      return;
    }
    traduzirTexto(searchInput.value);
  });
  chatForm.addEventListener('submit', (e) => {
    e.preventDefault();
    traduzirTexto(chatInput.value);
  });
  exemplos.forEach((botao) => botao.addEventListener('click', () => traduzirTexto(botao.dataset.exemplo)));

  // ── Tradução por áudio (mensagem de voz) ──────────────────
  function extensaoDoAudio(mimeType) {
    if (mimeType.includes('mp4')) return 'm4a';
    if (mimeType.includes('ogg')) return 'ogg';
    return 'webm';
  }

  const formatarDuracao = (s) => `0:${String(Math.max(0, Math.round(s))).padStart(2, '0')}`;

  // Balão de voz do usuário: dá para ouvir de novo o que foi gravado; a transcrição aparece embaixo
  function balaoDeVoz(blob, segundos) {
    const url = URL.createObjectURL(blob);
    audiosGravados.push(url);
    const audio = new Audio(url);
    const botao = criar('button', { classe: 'voz-play', texto: '▶', atributos: { type: 'button', 'aria-label': 'Ouvir o áudio gravado' } });
    const barra = criar('span', { classe: 'voz-onda', atributos: { 'aria-hidden': 'true' } },
      Array.from({ length: 22 }, (_, i) => criar('i', { atributos: { style: `height:${30 + Math.round(Math.abs(Math.sin(i * 1.7)) * 70)}%` } })));
    const duracao = criar('span', { classe: 'voz-duracao', texto: formatarDuracao(segundos) });
    botao.addEventListener('click', () => {
      if (audio.paused) { if (playerAtivo) playerAtivo.pausar(); audio.play(); } else { audio.pause(); }
    });
    audio.addEventListener('play', () => { botao.textContent = '❚❚'; botao.setAttribute('aria-label', 'Pausar o áudio'); });
    const parado = () => { botao.textContent = '▶'; botao.setAttribute('aria-label', 'Ouvir o áudio gravado'); };
    audio.addEventListener('pause', parado);
    audio.addEventListener('ended', parado);
    const transcricao = criar('p', { classe: 'msg-transcricao', texto: 'transcrevendo…' });
    return {
      conteudo: [criar('div', { classe: 'voz' }, [criar('span', { classe: 'voz-mic', texto: '🎤', atributos: { 'aria-hidden': 'true' } }), botao, barra, duracao]), transcricao],
      transcrito(texto) {
        transcricao.textContent = texto ? `“${texto}”` : 'Não deu para entender o áudio.';
        transcricao.classList.toggle('falhou', !texto);
      },
    };
  }

  let pararGravacao = null;

  async function gravarAudio() {
    if (gravando) { if (pararGravacao) pararGravacao(); return; } // tocar de novo encerra e envia antes dos 5 s
    if (traduzindo) return;

    let stream;
    try {
      stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch (e) {
      if (conversa.hidden) statusInicio.textContent = 'Não foi possível acessar o microfone. Verifique a permissão do navegador.';
      else mensagemBot().erro('Não foi possível acessar o microfone. Verifique a permissão do navegador.');
      return;
    }

    abrirConversa();
    if (playerAtivo) playerAtivo.pausar();
    gravando = true;
    atualizarBloqueios();
    atualizarBotaoChat();
    chatInput.hidden = true;
    gravandoEl.hidden = false;

    const partes = [];
    let tipo = 'audio/webm';
    let gravou = false;
    let relogio = null;
    const comeco = Date.now();
    try {
      const recorder = new MediaRecorder(stream);
      recorder.ondataavailable = (e) => { if (e.data.size) partes.push(e.data); };
      const terminou = new Promise((resolve) => { recorder.onstop = resolve; });
      pararGravacao = () => { if (recorder.state !== 'inactive') recorder.stop(); };
      recorder.start();
      const atualizarRelogio = () => {
        const restante = Math.ceil((DURACAO_GRAVACAO_MS - (Date.now() - comeco)) / 1000);
        gravandoTxt.textContent = `Gravando… fale agora · ${formatarDuracao(Math.max(restante, 0))}`;
      };
      atualizarRelogio();
      relogio = setInterval(atualizarRelogio, 250);
      setTimeout(pararGravacao, DURACAO_GRAVACAO_MS);
      await terminou;
      tipo = recorder.mimeType || tipo;
      gravou = partes.length > 0;
    } catch (e) {
      console.warn('Falha na gravação:', e);
    } finally {
      clearInterval(relogio);
      pararGravacao = null;
      stream.getTracks().forEach((t) => t.stop());
      gravandoEl.hidden = true;
      chatInput.hidden = false;
    }

    gravando = false;
    atualizarBotaoChat();
    if (!gravou) {
      atualizarBloqueios();
      mensagemBot().erro('Não foi possível gravar o áudio neste navegador.');
      return;
    }

    const blob = new Blob(partes, { type: tipo });
    const voz = balaoDeVoz(blob, (Date.now() - comeco) / 1000);
    const enviada = mensagemUsuario(voz.conteudo);
    const resposta = mensagemBot();

    const formData = new FormData();
    formData.append('file', blob, `gravacao.${extensaoDoAudio(tipo)}`);
    formData.append('exclusoes', JSON.stringify(listaExclusoes()));

    traduzindo = true;
    atualizarBloqueios();
    try {
      // /api/transcrever já devolve a tradução: não é preciso chamar /api/sugestao de novo
      const resultado = await chamarApi('/api/transcrever', { method: 'POST', body: formData });
      const transcrito = resultado.dados?.texto_transcrito;
      voz.transcrito(transcrito);
      enviada.respondida();
      tratarResultadoTraducao(resposta, resultado, transcrito || '');
    } finally {
      traduzindo = false;
      atualizarBloqueios();
    }
  }

  recordBtn.addEventListener('click', gravarAudio);
  chatAcao.addEventListener('click', (e) => {
    if (chatAcao.dataset.modo === 'enviar') return; // o submit do formulário cuida
    e.preventDefault();
    gravarAudio();
  });
  atualizarBotaoChat();

  // ── Tradução automática pela URL (?word=) ─────────────────
  const palavraUrl = new URLSearchParams(window.location.search).get('word');
  if (palavraUrl) traduzirTexto(palavraUrl.slice(0, LIMITE_TEXTO));
})();
</script>

