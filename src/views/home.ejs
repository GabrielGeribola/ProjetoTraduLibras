<%- include('includes/head'); %>
<%- include('includes/navbar'); %>

<!-- Modal de Vídeo Tutorial -->
<div class="tutorial-overlay" id="tutorialOverlay" role="dialog" aria-modal="true" aria-labelledby="tutorialTitulo">
  <div class="tutorial-modal">
    <div class="tutorial-modal-header">
      <span id="tutorialTitulo">📹 Vídeo Tutorial</span>
      <button class="tutorial-close" id="tutorialClose" aria-label="Fechar tutorial">✕</button>
    </div>
    <div class="tutorial-video-wrap">
      <video id="tutorialVideo" controls playsinline></video>
    </div>
    <p class="tutorial-caption">Aprenda a usar o TraduLibras em poucos minutos.</p>
  </div>
</div>

<!-- Tela inicial (mesmo padrão de Cursos e Planos) -->
<main class="planos-container tradutor-pagina" id="inicio">
  <div class="planos-cabecalho">
    <h1 class="planos-titulo">Tradutor</h1>
    <p class="planos-subtitulo">Escreva ou fale em português e veja a frase em Libras, sinal por sinal.</p>
    <div class="tradutor-ajudas">
      <button type="button" class="tradutor-tutorial" data-tutorial>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/>
        </svg>
        Como usar (vídeo tutorial)
      </button>
      <%# Demonstração só quando a pessoa pede (antes rodava sozinha na primeira visita) %>
      <button type="button" class="tradutor-tutorial" id="verExemplo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>
        </svg>
        Ver um exemplo
      </button>
    </div>
  </div>

  <section class="tradutor-caixa" aria-label="Traduzir para Libras">
    <form id="searchForm" class="tradutor-form">
      <label for="input_text" class="tradutor-rotulo">Palavra ou frase em português</label>
      <div class="tradutor-linha">
        <input type="text" class="input-home tradutor-input" id="input_text" name="input_text"
               placeholder="Ex.: tudo bem? eu gosto de café" maxlength="300" autocomplete="off" enterkeyhint="go"
               aria-describedby="tradutorDica">
        <button type="button" class="plano-botao plano-botao-secundario btn-falar" id="recordBtn" aria-label="Falar: grava sua voz por até 5 segundos">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="17" x2="12" y2="22"/>
          </svg>
          Falar
        </button>
        <button type="submit" class="plano-botao btn-traduzir" id="searchSubmit">
          Traduzir
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
      <p class="tradutor-dica" id="tradutorDica">Frases curtas funcionam melhor. Nomes e palavras sem sinal podem ser soletrados letra por letra.</p>
      <p class="tradutor-status" id="tradutorStatus" role="status" aria-live="polite"></p>
    </form>

    <div class="tradutor-exemplos" role="group" aria-label="Exemplos para experimentar">
      <span class="tradutor-exemplos-rotulo">Experimente:</span>
      <%# Só frases que o banco traduz por inteiro ("bom dia" e "qual é o seu nome?" ficavam sem BOM e SEU) %>
      <% ['tudo bem?', 'eu te amo', 'obrigado', 'eu gosto de café', 'meu nome é Ana'].forEach((exemplo) => { %>
        <button type="button" class="curso-chip" data-exemplo="<%= exemplo %>"><%= exemplo %></button>
      <% }); %>
    </div>
  </section>

  <%# Como funciona: três passos, do texto (ou voz) ao vídeo %>
  <section class="home-secao" aria-labelledby="comoFuncionaTitulo">
    <h2 class="secao-titulo" id="comoFuncionaTitulo">Como funciona</h2>
    <ol class="passos">
      <li class="passo">
        <span class="passo-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/></svg>
        </span>
        <span class="passo-numero">Passo 1</span>
        <h3>Escreva ou fale</h3>
        <p>Digite uma frase em português ou grave um áudio curto pelo microfone.</p>
      </li>
      <li class="passo">
        <span class="passo-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h11M4 12h7M4 17h11"/><path d="m15 10 4 4-4 4"/><path d="M19 14H11"/></svg>
        </span>
        <span class="passo-numero">Passo 2</span>
        <h3>A frase vira Libras</h3>
        <p>O TraduLibras organiza a frase na ordem da Libras e escolhe o sinal de cada palavra.</p>
      </li>
      <li class="passo">
        <span class="passo-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m10 9 5 3-5 3z" fill="currentColor"/></svg>
        </span>
        <span class="passo-numero">Passo 3</span>
        <h3>Assista sinal por sinal</h3>
        <p>Os vídeos tocam em sequência. Dá para repetir, desacelerar e soletrar nomes.</p>
      </li>
    </ol>
  </section>

  <%# Atalhos com números reais do banco (somem se o banco não responder) %>
  <section class="home-secao" aria-labelledby="exploreTitulo">
    <h2 class="secao-titulo" id="exploreTitulo">Explore o TraduLibras</h2>
    <div class="explorar">
      <a href="/sugestoes" class="explorar-card">
        <span class="explorar-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </span>
        <% if (typeof numeros !== 'undefined' && numeros && numeros.palavras) { %>
          <strong class="explorar-numero"><span data-contar="<%= numeros.palavras %>"><%= numeros.palavras.toLocaleString('pt-BR') %></span>+</strong>
          <span class="explorar-legenda">palavras e expressões com sinal</span>
        <% } %>
        <h3>Glossário</h3>
        <p>Procure uma palavra ou navegue por categoria e veja o sinal na hora.</p>
        <span class="explorar-seta" aria-hidden="true">Abrir o glossário →</span>
      </a>
      <a href="/cursos" class="explorar-card">
        <span class="explorar-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5C4.5 5 7.5 5 10 6.5V20c-2.5-1.5-5.5-1.5-8 0z"/><path d="M22 6.5C19.5 5 16.5 5 14 6.5V20c2.5-1.5 5.5-1.5 8 0z"/></svg>
        </span>
        <% if (typeof numeros !== 'undefined' && numeros && numeros.conteudos) { %>
          <strong class="explorar-numero"><span data-contar="<%= numeros.conteudos %>"><%= numeros.conteudos %></span></strong>
          <span class="explorar-legenda">vídeos e artigos selecionados</span>
        <% } %>
        <h3>Cursos</h3>
        <p>Aprenda Libras e conheça a cultura surda com conteúdos gratuitos.</p>
        <span class="explorar-seta" aria-hidden="true">Ver os cursos →</span>
      </a>
      <a href="/planos" class="explorar-card">
        <span class="explorar-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V8l7-4 7 4v13"/><path d="M9 21v-6h6v6M9 10h.01M15 10h.01"/></svg>
        </span>
        <strong class="explorar-numero">Grátis</strong>
        <span class="explorar-legenda">para começar, sem cadastro</span>
        <h3>Planos</h3>
        <p>Para escolas, empresas e ONGs que traduzem textos maiores todos os dias.</p>
        <span class="explorar-seta" aria-hidden="true">Conhecer os planos →</span>
      </a>
    </div>
  </section>
</main>

<!-- Conversa (estilo WhatsApp): abre na primeira tradução -->
<section class="conversa" id="conversa" aria-labelledby="conversaNome" hidden>
  <header class="conversa-topo">
    <span class="conversa-avatar" aria-hidden="true">🤟</span>
    <div class="conversa-info">
      <h1 class="conversa-nome" id="conversaNome">TraduLibras</h1>
      <p class="conversa-status" id="conversaStatus">online</p>
    </div>
    <div class="conversa-acoes">
      <button type="button" class="conversa-icone" data-tutorial aria-label="Ver o vídeo tutorial" title="Tutorial">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>
      </button>
      <button type="button" class="conversa-icone" id="btnLimpar" aria-label="Nova conversa: apaga as mensagens e volta ao início" title="Nova conversa">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>
      </button>
    </div>
  </header>

  <div class="conversa-mensagens" id="listaMensagens" aria-label="Mensagens">
    <div class="conversa-dia"><span>Hoje</span></div>
  </div>

  <form class="conversa-rodape" id="chatForm">
    <div class="conversa-campo" id="conversaCampo">
      <label for="chat_input" class="sr-only">Frase para traduzir</label>
      <input type="text" class="conversa-input" id="chat_input" name="chat_input" placeholder="Digite uma frase"
             maxlength="300" autocomplete="off" enterkeyhint="send">
      <p class="conversa-gravando" id="conversaGravando" hidden>
        <span class="conversa-gravando-ponto" aria-hidden="true"></span>
        <span id="conversaGravandoTexto">Gravando… 0:05</span>
        <span class="nivel-voz" aria-hidden="true" title="Volume captado pelo microfone"><i></i></span>
      </p>
    </div>
    <button type="button" class="conversa-botao" id="chatAcao" aria-label="Gravar áudio">
      <svg class="icone-mic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="17" x2="12" y2="22"/>
      </svg>
      <svg class="icone-enviar" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 21 12 3.4 3.6l-.01 6.53L15 12 3.39 13.87z"/></svg>
      <svg class="icone-parar" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
    </button>
  </form>
</section>

<p class="sr-only" id="anuncio" aria-live="polite"></p>

<%# Sinais que o usuário logado marcou como incorretos (JSON seguro para <script>) %>
<script type="application/json" id="dadosExclusoes"><%- JSON.stringify(typeof exclusoes !== 'undefined' ? exclusoes : []).replace(/</g, '\\u003c') %></script>

<script>
(() => {
  'use strict';

  // ── Configuração ──────────────────────────────────────────
  // A tradução passa pelo servidor do site (/traduzir e /traduzir/voz), que aplica o limite de tokens do plano
  const USUARIO_LOGADO = <%= (typeof user !== 'undefined' && user) ? 'true' : 'false' %>;
  const CSRF_TOKEN = document.querySelector('meta[name="csrf-token"]')?.content || '';
  const TEMPO_LIMITE_MS = 30000;
  const DURACAO_GRAVACAO_MS = 5000;
  const LIMITE_TEXTO = 300;
  const VELOCIDADES = [0.5, 0.75, 1];
  const CHAVE_VELOCIDADE = 'tradulibras:velocidade';

  // ── Elementos ─────────────────────────────────────────────
  const inicio       = document.getElementById('inicio');
  const conversa     = document.getElementById('conversa');
  const searchForm   = document.getElementById('searchForm');
  const searchInput  = document.getElementById('input_text');
  const recordBtn    = document.getElementById('recordBtn');
  const statusInicio = document.getElementById('tradutorStatus');
  const lista        = document.getElementById('listaMensagens');
  const chatForm     = document.getElementById('chatForm');
  const chatInput    = document.getElementById('chat_input');
  const chatAcao     = document.getElementById('chatAcao');
  const statusTopo   = document.getElementById('conversaStatus');
  const gravandoEl   = document.getElementById('conversaGravando');
  const gravandoTxt  = document.getElementById('conversaGravandoTexto');
  const anuncio      = document.getElementById('anuncio');
  const exemplos     = [...document.querySelectorAll('[data-exemplo]')];

  let traduzindo = false;
  let gravando = false;
  let playerAtivo = null;
  const players = new Set();
  const audiosGravados = [];

  let velocidade = 1;
  try {
    const salva = Number(localStorage.getItem(CHAVE_VELOCIDADE));
    if (VELOCIDADES.includes(salva)) velocidade = salva;
  } catch (e) { /* armazenamento indisponível */ }

  // ── Sinais ocultados (resultado do feedback negativo) ─────
  // Logado: vêm do banco e valem em qualquer dispositivo.
  // Visitante: ficam só nesta aba do navegador (sessionStorage) e somem ao fechá-la.
  // Nos dois casos são enviados junto com cada tradução e só mudam o resultado de quem votou.
  const CHAVE_SESSAO = 'tradulibras:sinaisOcultos';
  const exclusoes = new Map();
  const normalizar = (t) => String(t || '').replace(/\s+/g, ' ').trim().toLowerCase();

  function guardarExclusoes(listaNova) {
    (listaNova || []).forEach((item) => {
      const termo = normalizar(item.termo);
      const expressao = normalizar(item.expressao);
      if (termo && expressao) exclusoes.set(`${termo}\u0000${expressao}`, { termo, expressao });
    });
  }
  const listaExclusoes = () => [...exclusoes.values()];

  if (USUARIO_LOGADO) {
    try { guardarExclusoes(JSON.parse(document.getElementById('dadosExclusoes').textContent)); } catch (e) { /* sem dados */ }
  } else {
    try { guardarExclusoes(JSON.parse(sessionStorage.getItem(CHAVE_SESSAO) || '[]')); } catch (e) { /* armazenamento indisponível */ }
  }

  function salvarNaSessao() {
    try { sessionStorage.setItem(CHAVE_SESSAO, JSON.stringify(listaExclusoes())); } catch (e) { /* armazenamento indisponível */ }
  }

  // ── Vídeo tutorial ────────────────────────────────────────
  const TUTORIAL_URL = 'https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/tutorial_tradulibras_com_som.mp4';
  const tutorialOverlay = document.getElementById('tutorialOverlay');
  const tutorialVideo   = document.getElementById('tutorialVideo');

  function abrirTutorial() {
    if (playerAtivo) playerAtivo.pausar();
    tutorialVideo.src = TUTORIAL_URL;
    tutorialVideo.load();
    tutorialVideo.play().catch(() => {});
    tutorialOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  document.querySelectorAll('[data-tutorial]').forEach((b) => b.addEventListener('click', abrirTutorial));
  // /home?tutorial=1 (link "Ver tutorial" da página Ajuda) já abre o vídeo
  if (new URLSearchParams(window.location.search).get('tutorial') === '1') abrirTutorial();

  function fecharTutorial() {
    if (!tutorialOverlay.classList.contains('open')) return;
    tutorialOverlay.classList.remove('open');
    tutorialVideo.pause();
    tutorialVideo.removeAttribute('src');
    tutorialVideo.load();
    document.body.style.overflow = '';
  }
  document.getElementById('tutorialClose').addEventListener('click', fecharTutorial);
  tutorialOverlay.addEventListener('click', (e) => { if (e.target === tutorialOverlay) fecharTutorial(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fecharTutorial(); });

  // ── Utilitários de DOM (sempre textContent: nada de HTML vindo do usuário/API) ──
  function criar(tag, { classe, texto, atributos } = {}, filhos = []) {
    const elemento = document.createElement(tag);
    if (classe) elemento.className = classe;
    if (texto !== undefined) elemento.textContent = texto;
    if (atributos) Object.entries(atributos).forEach(([k, v]) => elemento.setAttribute(k, v));
    filhos.forEach((filho) => elemento.append(filho));
    return elemento;
  }

  const anunciar = (texto) => { anuncio.textContent = ''; setTimeout(() => { anuncio.textContent = texto; }, 50); };
  const horaAgora = () => new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });

  // ── Movimento ─────────────────────────────────────────────
  const movimentoReduzido = () => (window.tlMovimentoReduzido ? window.tlMovimentoReduzido() : false);
  const podeTransicionar = () => Boolean(document.startViewTransition) && !movimentoReduzido();
  // Curva de mola do CSS (--mola) para animações em JS; "ease-out" se o navegador não aceitar linear()
  function curvaMola() {
    const curva = getComputedStyle(document.documentElement).getPropertyValue('--mola').trim();
    return curva && CSS.supports('transition-timing-function', curva) ? curva : 'ease-out';
  }

  // ── Estado da conversa ────────────────────────────────────
  // A caixa do tradutor "vira" a janela da conversa (View Transition, CSS: janela-tradutor).
  // montar() cria as mensagens dentro da transição e devolve o elemento para onde o texto "voa"
  // a partir de `origem` (o campo digitado ou o exemplo clicado).
  // chegada: veio de outra página (Glossário, Histórico: /home?word=). A conversa abre na hora, antes de
  // a página aparecer, e o balão recebe o nome "texto-enviado": na transição entre páginas, a palavra
  // clicada lá "voa" até ele (movimento.js nomeia a origem).
  async function abrirConversa(montar = () => null, origem = null, { chegada = false } = {}) {
    if (!conversa.hidden) { montar(); return; }
    let destino = null;
    const mostrar = () => {
      inicio.hidden = true;
      conversa.hidden = false;
      document.body.classList.add('em-conversa');
      window.scrollTo(0, 0);
      destino = montar();
      if ((origem || chegada) && destino) destino.style.viewTransitionName = 'texto-enviado';
    };
    if (chegada) {
      mostrar();
      const limpar = () => { if (destino) destino.style.viewTransitionName = ''; };
      window.addEventListener('pagereveal', (e) => {
        if (e.viewTransition) e.viewTransition.finished.finally(limpar); else limpar();
      }, { once: true });
      setTimeout(limpar, 4000); // garantia, caso a página apareça sem transição
      return;
    }
    if (!podeTransicionar()) { mostrar(); return; }

    if (origem) origem.style.viewTransitionName = 'texto-enviado';
    const transicao = document.startViewTransition(mostrar);
    transicao.finished.finally(() => {
      if (origem) origem.style.viewTransitionName = '';
      if (destino) destino.style.viewTransitionName = '';
    });
    await transicao.updateCallbackDone.catch(() => {});
  }

  function definirStatus(texto) { statusTopo.textContent = texto; }

  // 4.9 Avatar 🤟 do topo da conversa acompanha o status (que continua em texto ao lado):
  // "traduzindo" respira; "chegou" dá um pulinho; "sem-sinal" inclina. Os dois últimos acontecem uma vez.
  const avatarEl = document.querySelector('.conversa-avatar');
  function avatar(estado) {
    if (!avatarEl) return;
    avatarEl.removeAttribute('data-estado');
    if (!estado) return;
    void avatarEl.offsetWidth; // reinicia a animação
    avatarEl.dataset.estado = estado;
  }
  if (avatarEl) avatarEl.addEventListener('animationend', () => { if (avatarEl.dataset.estado !== 'traduzindo') avatar(null); });

  function atualizarBloqueios() {
    const ocupado = traduzindo || gravando;
    exemplos.forEach((b) => { b.disabled = ocupado; });
    document.getElementById('searchSubmit').disabled = ocupado;
    recordBtn.disabled = ocupado;
    chatAcao.disabled = traduzindo && !gravando;
    if (gravando) definirStatus('gravando áudio…');
    else if (traduzindo) definirStatus('traduzindo…');
    else definirStatus('online');
    if (traduzindo && !gravando) { if (avatarEl && avatarEl.dataset.estado !== 'traduzindo') avatar('traduzindo'); }
    else if (avatarEl && avatarEl.dataset.estado === 'traduzindo') avatar(null);
  }

  // 4.3 Shift segurado = câmera lenta no sinal que está tocando (fora dos campos de texto)
  const emCampoDeTexto = (el) => el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Shift' && !e.repeat && playerAtivo && !emCampoDeTexto(document.activeElement)) playerAtivo.camera(true);
  });
  document.addEventListener('keyup', (e) => { if (e.key === 'Shift' && playerAtivo) playerAtivo.camera(false); });
  window.addEventListener('blur', () => { if (playerAtivo) playerAtivo.camera(false); });

  // Botão redondo do rodapé: microfone com o campo vazio, "enviar" quando há texto, "parar" gravando
  function atualizarBotaoChat() {
    const modo = gravando ? 'parar' : (chatInput.value.trim() ? 'enviar' : 'mic');
    chatAcao.dataset.modo = modo;
    chatAcao.setAttribute('aria-label', { parar: 'Parar e enviar o áudio', enviar: 'Traduzir', mic: 'Gravar áudio' }[modo]);
    chatAcao.type = modo === 'enviar' ? 'submit' : 'button';
  }
  chatInput.addEventListener('input', atualizarBotaoChat);

  // Rola para mostrar a mensagem nova (se for alta, mostra o começo dela)
  function rolarPara(elemento) {
    requestAnimationFrame(() => {
      const alta = elemento.offsetHeight > lista.clientHeight - 24;
      lista.scrollTop = alta ? elemento.offsetTop - 12 : lista.scrollHeight;
    });
  }

  function rodape(extra = []) {
    return criar('span', { classe: 'msg-rodape' }, [criar('time', { texto: horaAgora() }), ...extra]);
  }

  // Mensagem do usuário (direita). Os tiques viram ✓✓ quando a resposta chega.
  // Tiques em SVG: o segundo "se desenha" quando a resposta chega (CSS .msg-tiques.lida)
  const TIQUES_SVG = '<svg viewBox="0 0 17 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">'
    + '<path class="tique-1" d="M1 6l3.2 3.2L10 2"/><path class="tique-2" d="M6.5 8.6l.6.6L15 2"/></svg>';

  function mensagemUsuario(conteudo) {
    const tiques = criar('span', { classe: 'msg-tiques', atributos: { 'aria-hidden': 'true' } });
    tiques.innerHTML = TIQUES_SVG; // texto fixo do próprio código, nada vindo do usuário
    const balao = criar('div', { classe: 'msg msg-usuario' }, [...conteudo, rodape([tiques])]);
    lista.append(balao);
    rolarPara(balao);
    return {
      balao,
      respondida() { tiques.classList.add('lida'); },
    };
  }

  // Resposta do TraduLibras (esquerda)
  function mensagemBot() {
    const balao = criar('div', { classe: 'msg msg-bot digitando' }, [
      criar('span', { classe: 'carregando-pontos', atributos: { 'aria-label': 'Traduzindo' } }, [criar('span'), criar('span'), criar('span')]),
    ]);
    lista.append(balao);
    rolarPara(balao);
    return {
      balao,
      erro(conteudo) {
        balao.className = 'msg msg-bot erro';
        balao.replaceChildren(
          criar('p', { classe: 'msg-texto' }, [criar('span', { texto: '⚠️ ', atributos: { 'aria-hidden': 'true' } }), conteudo]),
          rodape(),
        );
        rolarPara(balao);
      },
      mostrar(elementos) {
        balao.className = 'msg msg-bot msg-traducao';
        balao.replaceChildren(...elementos, rodape());
        rolarPara(balao);
      },
      responder(elementos) {
        balao.className = 'msg msg-bot';
        balao.replaceChildren(...elementos, rodape());
        rolarPara(balao);
      },
    };
  }

  function limparConversa() {
    players.forEach((p) => p.pausar());
    players.clear();
    playerAtivo = null;
    audiosGravados.splice(0).forEach((url) => URL.revokeObjectURL(url));
    const voltar = () => {
      lista.replaceChildren(criar('div', { classe: 'conversa-dia' }, [criar('span', { texto: 'Hoje' })]));
      conversa.hidden = true;
      inicio.hidden = false;
      document.body.classList.remove('em-conversa');
    };
    // A conversa "encolhe" de volta para a caixa do tradutor
    if (!podeTransicionar()) { voltar(); searchInput.focus(); return; }
    document.startViewTransition(voltar).updateCallbackDone.then(() => searchInput.focus(), () => searchInput.focus());
  }
  document.getElementById('btnLimpar').addEventListener('click', () => {
    if (lista.querySelector('.msg') && !window.confirm('Apagar esta conversa e voltar ao início?')) return;
    limparConversa();
  });

  // ── Chamada à API com tempo limite ────────────────────────
  async function chamarApi(caminho, opcoes) {
    const controle = new AbortController();
    const timer = setTimeout(() => controle.abort(), TEMPO_LIMITE_MS);
    try {
      const resposta = await fetch(caminho, {
        ...opcoes,
        headers: { ...(opcoes.headers || {}), 'X-CSRF-Token': CSRF_TOKEN },
        signal: controle.signal,
      });
      let dados = null;
      try { dados = await resposta.json(); } catch (e) { dados = null; }
      return { ok: resposta.ok, status: resposta.status, dados };
    } catch (erro) {
      return { ok: false, status: 0, dados: null, tipo: erro.name === 'AbortError' ? 'tempo' : 'rede' };
    } finally {
      clearTimeout(timer);
    }
  }

  // Mensagens claras para cada tipo de falha
  function mensagemDeErro(resultado) {
    const { status, dados, tipo } = resultado;
    if (tipo === 'tempo') return 'A tradução está demorando mais que o normal. Tente novamente em instantes.';
    if (tipo === 'rede') return 'Não foi possível conectar ao serviço de tradução. Verifique sua conexão e tente novamente.';
    if (status === 404 && dados && dados.codigo === 'SEM_SINAIS') {
      const partes = ['Ainda não temos sinais para essa frase. '];
      if (Array.isArray(dados.sem_sinal) && dados.sem_sinal.length) partes.push(`Sem sinal: ${dados.sem_sinal.join(', ')}. `);
      partes.push('Veja as palavras disponíveis no ', criar('a', { texto: 'Glossário', atributos: { href: dados.sugestao_link || '/sugestoes' } }), '.');
      return criar('span', {}, partes);
    }
    if (dados && dados.codigo === 'LIMITE_PLANO') {
      return criar('span', {}, [
        `${dados.mensagem} Divida a frase em partes menores ou veja os `,
        criar('a', { texto: 'planos sem limite', atributos: { href: dados.planos_link || '/planos' } }),
        '.',
      ]);
    }
    if (status >= 500 || !dados) return 'O serviço de tradução está com problemas agora. Tente novamente em alguns minutos.';
    return dados.mensagem || 'Não foi possível processar o pedido.';
  }

  // ── Sinais da resposta ────────────────────────────────────
  // Explica quando o sinal não é a palavra exata digitada
  function notaDoSinal(item) {
    const termo = item.termo_original || '';
    if (item.metodo === 'datilologia') return `soletrando “${termo}”`;
    if (item.aproximado) return `sinal aproximado para “${termo}”`;
    if (item.metodo === 'correcao') return `você escreveu “${termo}”`;
    if (['sinonimo', 'variacao', 'lema'].includes(item.metodo) && normalizar(termo) !== normalizar(item.expressao_libras)) {
      return `para “${termo}”`;
    }
    return '';
  }

  // Um item por sinal; letras soletradas seguidas da mesma palavra viram um item só ("A-N-A")
  function agruparSinais(sequencia) {
    const grupos = [];
    sequencia.forEach((item, i) => {
      const nome = String(item.expressao_libras || item.termo_original || '').toUpperCase();
      const anterior = grupos[grupos.length - 1];
      if (item.metodo === 'datilologia' && anterior && anterior.soletrado && anterior.termo === item.termo_original) {
        anterior.fim = i;
        anterior.rotulo += `-${nome}`;
        return;
      }
      grupos.push({
        inicio: i, fim: i, rotulo: nome, termo: item.termo_original,
        soletrado: item.metodo === 'datilologia', aproximado: Boolean(item.aproximado), nota: notaDoSinal(item),
      });
    });
    return grupos;
  }

  // ── Player dos sinais ─────────────────────────────────────
  // Dois <video> alternados: enquanto um toca, o outro já carrega o próximo sinal (sem pausa entre sinais).
  // A sequência toca uma vez; depois aparece "Repetir". Clicar num sinal da lista toca a partir dele.
  // introducao(): animação antes do 1º sinal (glosa cinética), ao iniciar e ao repetir; devolve
  //   { promessa, pular }. aoTerminar(): chamado quando o último sinal acaba.
  // aoMudarSinal(g): avisa o sinal atual (g) para a frase sincronizada e a linha do tempo; trechos: a régua.
  function criarPlayer({ palco, legenda, botaoPausa, botaoRepetir, chips, grupos, sequencia, trechos = [], introducao, aoTerminar, aoMudarSinal }) {
    let [atual, proximo] = palco.querySelectorAll('video');
    const total = sequencia.length;
    let indice = 0;
    let terminou = false;
    let comecou = false;
    let quadro = 0;
    let intro = null; // introdução em andamento
    let lento = false; // 4.3 câmera lenta enquanto segura o vídeo (ou a tecla Shift)

    // ── 4.3 Câmera lenta: segurar o quadro (ou Shift) toca a 0,5×; soltar volta à velocidade escolhida ──
    const seloLento = criar('span', { classe: 'selo-lento', texto: '0,5×', atributos: { 'aria-hidden': 'true' } });
    seloLento.hidden = true;
    palco.append(seloLento);
    function camera(sim) {
      if (lento === sim) return;
      lento = sim;
      seloLento.hidden = !sim;
      aplicarVelocidade(atual);
      aplicarVelocidade(proximo);
    }
    let timerSegurar = null;
    let segurou = false;
    palco.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      segurou = false;
      timerSegurar = setTimeout(() => { segurou = true; camera(true); }, 280);
    });
    const soltarQuadro = () => { clearTimeout(timerSegurar); if (lento) camera(false); };
    ['pointerup', 'pointercancel', 'pointerleave'].forEach((ev) => palco.addEventListener(ev, soltarQuadro));
    // Depois de segurar, o "clique" ao soltar não pausa o vídeo
    palco.addEventListener('click', (e) => {
      if (!segurou) return;
      segurou = false;
      e.stopImmediatePropagation();
    }, { capture: true });
    palco.addEventListener('contextmenu', (e) => e.preventDefault()); // toque longo no celular não abre menu

    function interromperIntro() {
      if (!intro) return;
      const emCurso = intro;
      intro = null;
      emCurso.pular();
    }

    const grupoDoIndice = (i) => grupos.findIndex((g) => i >= g.inicio && i <= g.fim);

    // O chip do sinal atual se preenche enquanto o vídeo toca (CSS --progresso).
    // Num nome soletrado (A-N-A), o chip só termina de encher na última letra.
    function acompanharProgresso() {
      cancelAnimationFrame(quadro);
      if (movimentoReduzido()) return;
      const passo = () => {
        const g = grupoDoIndice(indice);
        const grupo = grupos[g];
        if (grupo && chips[g] && atual.duration > 0) {
          const partes = grupo.fim - grupo.inicio + 1;
          const fracao = Math.min(1, (indice - grupo.inicio + atual.currentTime / atual.duration) / partes);
          chips[g].style.setProperty('--progresso', fracao.toFixed(3));
          if (trechos[g]) trechos[g].style.setProperty('--progresso', fracao.toFixed(3));
        }
        if (!atual.paused && !atual.ended) quadro = requestAnimationFrame(passo);
      };
      quadro = requestAnimationFrame(passo);
    }

    function aplicarVelocidade(video) {
      const taxa = lento ? Math.min(0.5, velocidade) : velocidade;
      video.defaultPlaybackRate = taxa;
      video.playbackRate = taxa;
    }

    function carregar(video, i) {
      if (video.dataset.indice === String(i)) return;
      video.dataset.indice = String(i);
      video.src = sequencia[i].url;
      video.load();
      aplicarVelocidade(video);
    }

    function atualizarLegenda(i) {
      const g = grupoDoIndice(i);
      const grupo = grupos[g];
      const partes = [`Sinal ${g + 1} de ${grupos.length}: `, criar('strong', { texto: grupo.rotulo })];
      if (grupo.nota) partes.push(criar('span', { classe: 'termo-nota', texto: ` (${grupo.nota})` }));
      legenda.replaceChildren(...partes);
      chips.forEach((chip, k) => {
        if (k === g) chip.setAttribute('aria-current', 'step');
        else { chip.removeAttribute('aria-current'); chip.style.removeProperty('--progresso'); }
      });
      if (aoMudarSinal) aoMudarSinal(g);
    }

    function tocar(i) {
      interromperIntro(); // tocar num sinal ou no quadro durante a glosa pula a glosa
      indice = i;
      terminou = false;
      comecou = true;
      botaoRepetir.hidden = true;
      botaoPausa.hidden = false;
      botaoPausa.textContent = '⏸ Pausar';
      carregar(atual, i);
      atual.classList.add('is-visible');
      proximo.classList.remove('is-visible');
      atualizarLegenda(i);
      aplicarVelocidade(atual);
      atual.play().catch((erro) => {
        // Navegador bloqueou o autoplay: o usuário inicia pelo botão.
        // (AbortError = o usuário pausou antes de o vídeo carregar; o botão já mostra "Continuar")
        if (erro && erro.name === 'NotAllowedError') botaoPausa.textContent = '▶ Reproduzir';
      });
      if (i + 1 < total) carregar(proximo, i + 1);
    }

    function avancar(evento) {
      if (evento.target !== atual) return;
      if (indice + 1 < total) {
        [atual, proximo] = [proximo, atual];
        tocar(indice + 1);
      } else {
        terminou = true;
        botaoPausa.hidden = true;
        botaoRepetir.hidden = false;
        chips.forEach((chip) => chip.style.removeProperty('--progresso'));
        if (aoMudarSinal) aoMudarSinal(grupos.length); // fim: nenhuma palavra em destaque, régua toda percorrida
        // "Frase completa": os sinais fazem uma ola e o "Repetir" entra com mola (só depois do vídeo)
        if (!movimentoReduzido() && botaoRepetir.animate) {
          const mola = curvaMola();
          chips.forEach((chip, k) => chip.animate(
            [{ translate: '0 0' }, { translate: '0 -7px', offset: 0.4 }, { translate: '0 0' }],
            { duration: 460, delay: Math.min(k * 55, 440), easing: 'ease-in-out' },
          ));
          botaoRepetir.animate([{ scale: 0.6, opacity: 0 }, { scale: 1, opacity: 1 }], { duration: 520, easing: mola });
        }
        if (aoTerminar) aoTerminar();
      }
    }

    // Começa do zero: glosa (se houver) e depois o 1º sinal. O primeiro sinal já vai carregando.
    function comecar() {
      interromperIntro();
      atual.pause();
      terminou = false;
      comecou = false;
      carregar(atual, 0);
      if (total > 1) carregar(proximo, 1);
      botaoRepetir.hidden = true;
      botaoPausa.hidden = false;
      const nova = introducao ? introducao() : null;
      if (!nova) { tocar(0); return; }
      intro = nova;
      botaoPausa.textContent = '⏭ Pular';
      nova.promessa.then(() => {
        if (intro !== nova) return; // pulada, ou outro player assumiu
        intro = null;
        if (players.has(controle) && playerAtivo === controle) tocar(0);
      });
    }

    [atual, proximo].forEach((video) => {
      video.addEventListener('ended', avancar);
      video.addEventListener('error', avancar); // vídeo indisponível: pula para o próximo sinal
      video.addEventListener('playing', (e) => { if (e.target === atual) acompanharProgresso(); });
    });

    const controle = {
      iniciar() { ativar(controle); comecar(); },
      pausar() {
        if (intro || !comecou) { // ainda na glosa: para tudo e espera o "Reproduzir"
          interromperIntro();
          botaoPausa.textContent = '▶ Reproduzir';
          return;
        }
        atual.pause();
        if (!terminou) botaoPausa.textContent = '▶ Continuar';
      },
      alternar() {
        if (intro || !comecou) { ativar(controle); tocar(0); return; } // "Pular" ou toque no quadro durante a glosa
        if (atual.paused) {
          ativar(controle);
          atual.play().catch(() => {});
          botaoPausa.textContent = '⏸ Pausar';
        } else {
          controle.pausar();
        }
      },
      irPara(i) {
        ativar(controle);
        // garante que o sinal escolhido seja recarregado no player visível
        atual.dataset.indice = '';
        tocar(i);
      },
      repetir() { ativar(controle); comecar(); }, // a glosa toca de novo antes dos sinais
      camera,
      grupoAtual() { return comecou ? grupoDoIndice(indice) : -1; },
      comecou() { return comecou; },
      velocidade() { aplicarVelocidade(atual); aplicarVelocidade(proximo); },
    };

    botaoPausa.addEventListener('click', () => controle.alternar());
    botaoRepetir.addEventListener('click', () => controle.repetir());
    chips.forEach((chip, k) => chip.addEventListener('click', () => controle.irPara(grupos[k].inicio)));
    palco.addEventListener('click', () => (terminou ? controle.repetir() : controle.alternar()));
    players.add(controle);
    return controle;
  }

  // Só um player toca por vez: ao iniciar um, o anterior é pausado
  function ativar(player) {
    if (playerAtivo && playerAtivo !== player) playerAtivo.pausar();
    playerAtivo = player;
  }

  // Velocidade: vale para todos os vídeos e fica guardada no navegador
  function seletorVelocidade() {
    const opcoes = VELOCIDADES.map((v) => {
      const botao = criar('button', {
        classe: 'ciclo-opcao',
        texto: `${String(v).replace('.', ',')}×`,
        atributos: { type: 'button', 'data-velocidade': String(v), 'aria-pressed': String(v === velocidade) },
      });
      botao.addEventListener('click', () => {
        velocidade = v;
        try { localStorage.setItem(CHAVE_VELOCIDADE, String(v)); } catch (e) { /* armazenamento indisponível */ }
        document.querySelectorAll('[data-velocidade]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.velocidade) === v)));
        players.forEach((p) => p.velocidade());
      });
      return botao;
    });
    return criar('div', { classe: 'ciclo-seletor velocidade', atributos: { role: 'group', 'aria-label': 'Velocidade dos vídeos', title: 'Velocidade' } }, opcoes);
  }

  // Palavras que ficaram de fora (sem sinal confiável no banco): melhor avisar do que mostrar um sinal errado
  function avisoSemSinal(termos) {
    if (!Array.isArray(termos) || termos.length === 0) return [];
    return [criar('p', { classe: 'traducao-sem-sinal' }, [
      criar('strong', { texto: 'Ainda sem sinal: ' }),
      termos.join(', '),
      '. ',
      criar('a', { texto: 'Sugerir', atributos: { href: '/sugestoes' } }),
    ])];
  }

  // ── Palavra sem sinal: perguntar antes de soletrar ────────
  // A API não soletra sozinha: devolve em `soletraveis` as palavras sem sinal que dá para soletrar.
  // A pessoa escolhe entre ver a palavra soletrada em Libras, letra por letra (a frase é traduzida de
  // novo pedindo a soletração), ou procurar no Glossário (em outra aba, para não perder a conversa).
  function listaDePalavras(palavras) {
    const entre = palavras.map((p) => `“${p}”`);
    try { return new Intl.ListFormat('pt-BR', { type: 'conjunction' }).format(entre); } catch (e) { return entre.join(', '); }
  }

  function palavrasSemSinal(dados) {
    const soletraveis = Array.isArray(dados?.soletraveis) ? dados.soletraveis : [];
    const semSinal = Array.isArray(dados?.sem_sinal) ? dados.sem_sinal : [];
    return { soletraveis, outras: semSinal.filter((p) => !soletraveis.includes(p)) };
  }

  function opcoesSemSinal(texto, palavras, outras = []) {
    const varias = palavras.length > 1;
    const soletrar = criar('button', {
      classe: 'btn-player btn-player-primario',
      texto: varias ? '🔤 Soletrar as palavras' : '🔤 Soletrar',
      atributos: { type: 'button' },
    });
    const glossario = criar('a', {
      classe: 'btn-player',
      texto: '📖 Ver o Glossário',
      atributos: { href: '/sugestoes', target: '_blank', rel: 'noopener' },
    });
    soletrar.addEventListener('click', async () => {
      if (traduzindo || gravando) return;
      soletrar.disabled = true;
      const ok = await traduzirTexto(texto, null, { soletrar: palavras });
      if (!ok) soletrar.disabled = false; // falhou: dá para tentar de novo
    });
    return [
      criar('p', { classe: 'sem-sinal-pergunta' }, [
        `Ainda não temos sinal para ${listaDePalavras(palavras)}. `,
        varias
          ? 'Quer ver essas palavras soletradas, letra por letra, ou procurar no Glossário?'
          : 'Quer ver a palavra soletrada, letra por letra, ou procurar no Glossário?',
        ...(outras.length ? [` Também sem sinal: ${outras.join(', ')}.`] : []),
      ]),
      criar('div', { classe: 'sem-sinal-opcoes', atributos: { role: 'group', 'aria-label': 'O que fazer com as palavras sem sinal' } }, [soletrar, glossario]),
    ];
  }

  // ── Resposta da tradução (balão com vídeo) ────────────────
  function renderTraducao(resposta, dados, entrada) {
    const sequencia = dados.sequencia || [];
    const grupos = agruparSinais(sequencia);

    const palco = criar('div', { classe: 'video-stage', atributos: { title: 'Toque para pausar ou continuar' } }, [
      criar('video', { classe: 'video-libras', atributos: { muted: '', playsinline: '', preload: 'auto', 'aria-label': 'Vídeo do sinal em Libras' } }),
      criar('video', { classe: 'video-libras', atributos: { muted: '', playsinline: '', preload: 'auto', 'aria-hidden': 'true' } }),
    ]);
    palco.querySelectorAll('video').forEach((v) => { v.muted = true; });

    const legenda = criar('p', { classe: 'termo-atual', atributos: { 'aria-live': 'polite' } });
    const botaoPausa = criar('button', { classe: 'btn-player', texto: '⏸ Pausar', atributos: { type: 'button' } });
    const botaoRepetir = criar('button', { classe: 'btn-player btn-player-primario', texto: '↻ Repetir', atributos: { type: 'button' } });
    botaoRepetir.hidden = true;

    const chips = grupos.map((g, k) => criar('button', {
      classe: `sinal-chip${g.aproximado ? ' aproximado' : ''}`,
      atributos: { type: 'button', title: g.nota ? `${g.rotulo}: ${g.nota}` : `Ver o sinal ${g.rotulo}` },
    }, [criar('span', { classe: 'sinal-num', texto: String(k + 1), atributos: { 'aria-hidden': 'true' } }), g.rotulo]));

    // Com um sinal só, a legenda embaixo do vídeo já explica; a lista de notas seria repetição
    const notas = grupos.length > 1 ? grupos.filter((g) => g.nota) : [];
    const fileira = criar('div', { classe: 'sinais-sequencia', atributos: { role: 'group', 'aria-label': 'Sinais da tradução, na ordem da Libras: escolha um para ver' } }, chips);

    // 4.1 A frase digitada embaixo do vídeo: a palavra do sinal que está tocando fica sublinhada.
    // (Visual: a legenda "Sinal 1 de 3: CAFÉ" já informa o leitor de tela.)
    const palavras = palavrasDe(entrada);
    const origens = origemDosSinais(palavras, grupos);
    const spansFrase = palavras.map((p, i) => criar('span', {
      classe: origens.some((o) => o.includes(i)) ? 'com-sinal' : 'sem-sinal', texto: p,
    }));
    const marca = criar('span', { classe: 'glosa-sync-marca' });
    const fraseSync = palavras.length > 1
      ? criar('p', { classe: 'glosa-sync', atributos: { 'aria-hidden': 'true' } },
        [marca, ...spansFrase.flatMap((s, i) => (i ? [' ', s] : [s]))])
      : null;
    function destacarPalavra(g) {
      if (!fraseSync) return;
      const indices = g >= 0 ? origens[g] || [] : [];
      spansFrase.forEach((s, i) => s.classList.toggle('atual', indices.includes(i)));
      if (!indices.length) { marca.style.opacity = '0'; return; }
      const primeira = spansFrase[indices[0]];
      const ultima = spansFrase[indices[indices.length - 1]];
      const mesmaLinha = primeira.offsetTop === ultima.offsetTop;
      marca.style.opacity = '1';
      marca.style.width = `${(mesmaLinha ? ultima.offsetLeft + ultima.offsetWidth : primeira.offsetLeft + primeira.offsetWidth) - primeira.offsetLeft}px`;
      marca.style.transform = `translate(${primeira.offsetLeft}px, ${primeira.offsetTop + primeira.offsetHeight}px)`;
    }

    // 4.2 Linha do tempo arrastável: um trecho por sinal (largura proporcional às letras de um nome
    // soletrado). Arrastar "esfrega" a sequência; setas, Home e End pulam de sinal em sinal.
    const trechos = grupos.map((g) => criar('span', { classe: 'linha-tempo-trecho', atributos: { style: `flex-grow:${g.fim - g.inicio + 1}` } }));
    const regua = grupos.length > 1
      ? criar('div', {
        classe: 'linha-tempo',
        atributos: {
          role: 'slider', tabindex: '0', 'aria-label': 'Linha do tempo dos sinais',
          'aria-valuemin': '1', 'aria-valuemax': String(grupos.length), 'aria-valuenow': '1',
          'aria-valuetext': `Sinal 1 de ${grupos.length}: ${grupos[0].rotulo}`,
        },
      }, trechos)
      : null;
    function marcarRegua(g) {
      if (!regua) return;
      trechos.forEach((t, k) => {
        t.classList.toggle('atual', k === g);
        t.classList.toggle('passado', g >= 0 && k < g);
        if (k !== g) t.style.removeProperty('--progresso');
      });
      if (g >= 0 && g < grupos.length) {
        regua.setAttribute('aria-valuenow', String(g + 1));
        regua.setAttribute('aria-valuetext', `Sinal ${g + 1} de ${grupos.length}: ${grupos[g].rotulo}`);
      }
    }

    // O balão da tradução fica numa linha própria; no fim do vídeo, as sugestões aparecem ao lado.
    // (Feito antes de o vídeo existir: mover um <video> no documento depois o faria pausar.)
    if (!resposta.balao.parentElement.classList.contains('msg-linha')) {
      const linha = criar('div', { classe: 'msg-linha' });
      resposta.balao.replaceWith(linha);
      linha.append(resposta.balao);
    }

    // Palavras sem sinal: as que dá para soletrar viram a pergunta; as outras, o aviso de sempre
    const { soletraveis, outras } = palavrasSemSinal(dados);
    const pergunta = soletraveis.length && entrada
      ? [criar('div', { classe: 'traducao-sem-sinal' }, opcoesSemSinal(entrada, soletraveis))]
      : [];

    resposta.mostrar([
      palco,
      ...(fraseSync ? [fraseSync] : []),
      legenda,
      criar('div', { classe: 'player-barra' }, [
        criar('div', { classe: 'player-controles' }, [botaoPausa, botaoRepetir]),
        seletorVelocidade(),
      ]),
      ...(regua ? [regua] : []),
      fileira,
      ...(notas.length
        ? [criar('ul', { classe: 'traducao-notas' }, notas.map((g) => criar('li', {}, [criar('strong', { texto: g.rotulo }), ` — ${g.nota}`])))]
        : []),
      ...avisoSemSinal(pergunta.length ? outras : dados.sem_sinal),
      ...pergunta,
      criarFeedback({ texto: entrada, glosa: dados.glosa || '', sequencia }),
    ]);

    // O vídeo só começa quando a glosa termina de se montar: as duas coisas não disputam o olhar.
    // "Repetir" mostra a glosa de novo. Ao fim da sequência, aparece o balão de sugestões (uma vez).
    let sugestoesCriadas = false;
    const player = criarPlayer({
      palco, legenda, botaoPausa, botaoRepetir, chips, grupos, sequencia, trechos,
      aoMudarSinal(g) { destacarPalavra(g); marcarRegua(g); },
      introducao() {
        try { return animarGlosa({ palco, entrada, grupos, chips }); } catch (e) { return null; } // nunca impede o vídeo
      },
      aoTerminar() {
        if (sugestoesCriadas) return; // se a pessoa fechou, não volta a abrir no "Repetir"
        sugestoesCriadas = true;
        mostrarSugestoes(resposta.balao, { entrada, sequencia });
      },
    });
    if (regua) {
      // Trecho sob o ponteiro; só troca de sinal quando muda de trecho (não reinicia o mesmo)
      const trechoEm = (x) => {
        const k = trechos.findIndex((t) => { const r = t.getBoundingClientRect(); return x >= r.left && x <= r.right; });
        if (k >= 0) return k;
        return x < trechos[0].getBoundingClientRect().left ? 0 : trechos.length - 1;
      };
      const irParaTrecho = (k) => { if (k !== player.grupoAtual() || !player.comecou()) player.irPara(grupos[k].inicio); };
      let arrastando = false;
      regua.addEventListener('pointerdown', (e) => {
        arrastando = true;
        regua.setPointerCapture(e.pointerId);
        regua.classList.add('arrastando');
        irParaTrecho(trechoEm(e.clientX));
      });
      regua.addEventListener('pointermove', (e) => { if (arrastando) irParaTrecho(trechoEm(e.clientX)); });
      const soltar = () => { arrastando = false; regua.classList.remove('arrastando'); };
      regua.addEventListener('pointerup', soltar);
      regua.addEventListener('pointercancel', soltar);
      regua.addEventListener('keydown', (e) => {
        const atual = Math.max(0, player.grupoAtual());
        const destino = { ArrowRight: atual + 1, ArrowUp: atual + 1, ArrowLeft: atual - 1, ArrowDown: atual - 1, Home: 0, End: grupos.length - 1 }[e.key];
        if (destino === undefined) return;
        e.preventDefault();
        player.irPara(grupos[Math.min(grupos.length - 1, Math.max(0, destino))].inicio);
      });
    }

    anunciar(`Tradução pronta: ${grupos.length} ${grupos.length === 1 ? 'sinal' : 'sinais'}.`);
    window.tlVibrar?.(25);
    avatar('chegou');
    player.iniciar();
  }

  // ── Glosa cinética ────────────────────────────────────────
  // A frase digitada aparece sobre a fileira de sinais: as palavras que a Libras não usa
  // (artigos, preposições, verbos de ligação) caem, e as outras deslizam até virar o sinal
  // na ordem da Libras ("eu sou lindo" → EU LINDO). Mostra, em menos de 0,7 s, como a glosa funciona.
  // É só visual: os botões dos sinais estão no lugar desde o início para teclado e leitor de tela.
  const PALAVRA = /[\p{L}\p{N}]+(?:[-'’][\p{L}\p{N}]+)*/gu;
  const palavrasDe = (texto) => String(texto || '').match(PALAVRA) || [];
  const semAcento = (texto) => normalizar(texto).normalize('NFD').replace(/[̀-ͯ]/g, '');

  // Para cada sinal, quais palavras digitadas viraram ele (termo_original da API)
  function origemDosSinais(palavras, grupos) {
    const usadas = new Set();
    const comparaveis = palavras.map(semAcento);
    return grupos.map((grupo) => {
      const alvo = palavrasDe(grupo.termo).map(semAcento);
      if (!alvo.length) return [];
      for (let i = 0; i + alvo.length <= comparaveis.length; i++) {
        if (alvo.every((p, k) => comparaveis[i + k] === p && !usadas.has(i + k))) {
          const indices = alvo.map((_, k) => i + k);
          indices.forEach((k) => usadas.add(k));
          return indices;
        }
      }
      return [];
    });
  }

  // Acontece DENTRO do quadro do vídeo, que fica preto enquanto o primeiro sinal carrega: é para onde
  // o olho já está indo. Etapas (~2 s no total; tocar no quadro pula):
  //   1. "Você escreveu": a frase aparece como foi digitada;
  //   2. as palavras que a Libras não usa caem, e as que ficam acendem;
  //   3. "Em Libras": as que ficaram deslizam para a ordem da Libras, já como sinais (EU LINDO);
  //   4. a glosa some e o primeiro sinal começa.
  // Devolve { promessa, pular } (promessa: hora de começar o vídeo) ou null quando não há glosa a mostrar.
  function animarGlosa({ palco, entrada, grupos, chips }) {
    const palavras = palavrasDe(entrada);
    if (movimentoReduzido() || !palavras.length || !grupos.length || !palco.animate) return null;
    palco.querySelectorAll('.glosa-palco').forEach((resto) => resto.remove());

    const origens = origemDosSinais(palavras, grupos);
    const sinalDaPalavra = new Map();
    origens.forEach((indices, k) => indices.forEach((i) => sinalDaPalavra.set(i, k)));

    const mola = curvaMola();

    const legenda = criar('span', { classe: 'glosa-legenda', texto: 'Você escreveu' });
    const spans = palavras.map((p) => criar('span', { classe: 'glosa-palavra', texto: p }));
    const linha = criar('div', { classe: 'glosa-linha' }, spans);
    const camada = criar('div', { classe: 'glosa-palco', atributos: { 'aria-hidden': 'true' } }, [legenda, linha]);
    palco.append(camada);

    // Tocar no quadro pula a glosa (o clique segue para o player, que começa o vídeo)
    let pulou = false;
    const pular = () => {
      pulou = true;
      palco.removeEventListener('click', pular, { capture: true });
      camada.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      camada.remove();
    };
    palco.addEventListener('click', pular, { capture: true });
    const parar = () => pulou;
    const espera = (ms) => new Promise((r) => { setTimeout(r, ms); });
    const fim = (a) => a.finished.catch(() => {});

    const promessa = (async () => {
      // 1. a frase como foi escrita
      await fim(camada.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 220, easing: 'ease-out', fill: 'both' }));
      await espera(380);
      if (parar()) return;

      // 2. o que a Libras não usa cai; o que fica acende
      const quedas = [];
      spans.forEach((span, i) => {
        if (sinalDaPalavra.has(i)) { span.classList.add('mantida'); return; }
        quedas.push(fim(span.animate([
          { transform: 'none', opacity: 1 },
          { transform: `translateY(34px) rotate(${i % 2 ? 12 : -12}deg)`, opacity: 0 },
        ], { duration: 420, delay: quedas.length * 60, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' })));
      });
      await Promise.all(quedas);
      await espera(quedas.length ? 120 : 260);
      if (parar()) return;

      // 3. o que ficou desliza para a ordem da Libras (FLIP: mede antes, troca, anima a diferença)
      const antes = new Map(spans.map((span) => [span, span.getBoundingClientRect()]));
      const sinais = grupos.map((grupo, k) => {
        const indices = origens[k];
        const span = indices.length ? spans[indices[0]] : criar('span', { classe: 'glosa-palavra mantida' });
        span.textContent = grupo.rotulo; // EU, LINDO, A-N-A...
        return span;
      });
      linha.replaceChildren(...sinais);
      legenda.textContent = 'Em Libras';
      fim(legenda.animate([{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' }));
      const movimentos = sinais.map((span, k) => {
        const depois = span.getBoundingClientRect();
        const inicio = antes.get(span);
        const quadros = inicio
          ? [{ transform: `translate(${inicio.left - depois.left}px, ${inicio.top - depois.top}px)` }, { transform: 'none' }]
          : [{ transform: 'scale(.4)', opacity: 0 }, { transform: 'none', opacity: 1 }]; // sinal sem palavra digitada (ex.: "te" → VOCÊ)
        return fim(span.animate(quadros, { duration: 560, delay: k * 45, easing: mola, fill: 'backwards' }));
      });
      // Os botões dos sinais, embaixo, acompanham a mesma ordem
      chips.forEach((chip, k) => chip.animate([{ transform: 'scale(.85)', opacity: 0.35 }, { transform: 'none', opacity: 1 }],
        { duration: 420, delay: 120 + k * 45, easing: mola, fill: 'backwards' }));
      await Promise.all(movimentos);
      await espera(520);
      if (parar()) return;

      // 4. a glosa sai enquanto o vídeo começa
      palco.removeEventListener('click', pular, { capture: true });
      fim(camada.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 240, easing: 'ease-in', fill: 'forwards' }))
        .then(() => camada.remove());
    })().catch(() => { camada.remove(); });
    return { promessa, pular };
  }

  // ── Sugestões: balão ao lado do vídeo quando a sequência termina ──
  // Vêm do glossário (só palavras e expressões que têm sinal):
  //   "Com essas palavras": expressões e derivadas dos sinais traduzidos (café → café da manhã, cafezinho);
  //   "Do mesmo tema": outras palavras da mesma categoria (Alimentos e bebidas...);
  //   "Para experimentar": frases do dia a dia.
  // Normal: 4 sugestões. Ampliar: tudo. Recolher: só o título. Fechar: some (e não volta no "Repetir").
  const API_GLOSSARIO = ['localhost', '127.0.0.1'].includes(window.location.hostname)
    ? 'http://localhost:5000/api/glossario'
    : '/api/glossario';
  // Conferidas na API: todos os sinais existem no banco
  const FRASES_EXEMPLO = ['tudo bem?', 'eu te amo', 'obrigado', 'por favor', 'desculpa', 'eu gosto de café', 'minha família é grande', 'meu nome é Ana'];
  const CATEGORIAS_FORA = new Set(['Alfabeto', 'Outros', 'Números e quantidades']);
  const SUGESTOES_VISIVEIS = 4;
  const caixasSugestoes = new Set();
  let glossarioCarregado = null;

  const textoComparavel = (t) => semAcento(String(t || '').replace(/_/g, ' ')).replace(/[^\p{L}\p{N}\s-]/gu, '').replace(/\s+/g, ' ').trim();
  const formatarSugestao = (t) => {
    const texto = String(t).replace(/_/g, ' ').replace(/\s+/g, ' ').trim().toLocaleLowerCase('pt-BR');
    return texto.charAt(0).toLocaleUpperCase('pt-BR') + texto.slice(1);
  };

  // Palavras com sinal (API, com acentos) + categorias (glossario.json); baixado uma vez, só quando preciso
  function carregarGlossario() {
    if (!glossarioCarregado) {
      const json = (url) => fetch(url).then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))));
      glossarioCarregado = Promise.allSettled([json('/data/glossario.json'), json(API_GLOSSARIO)]).then(([arquivo, api]) => {
        const categorias = new Map();
        if (arquivo.status === 'fulfilled') arquivo.value.forEach((item) => categorias.set(textoComparavel(item.label), item.categoria || 'Outros'));
        let rotulos = [];
        if (api.status === 'fulfilled' && Array.isArray(api.value.palavras)) rotulos = api.value.palavras;
        else if (arquivo.status === 'fulfilled') rotulos = arquivo.value.map((item) => item.label);
        return rotulos.map((rotulo) => {
          const chave = textoComparavel(rotulo);
          return { texto: String(rotulo).replace(/_/g, ' '), chave, palavras: chave.split(/[\s-]+/), categoria: categorias.get(chave) || 'Outros' };
        }).filter((p) => p.chave.length > 1);
      }).catch(() => []);
    }
    return glossarioCarregado;
  }

  function montarSugestoes({ entrada, sequencia }, glossario) {
    const usados = new Set([textoComparavel(entrada)]);
    const alvo = new Set(); // palavras dos sinais traduzidos
    sequencia.forEach((item) => {
      if (item.metodo === 'datilologia') return;
      [item.expressao_libras, item.termo_original].forEach((t) => {
        usados.add(textoComparavel(t));
        palavrasDe(t).forEach((p) => { const c = textoComparavel(p); if (c.length >= 3) alvo.add(c); });
      });
    });
    const novo = (p) => !usados.has(p.chave);
    const acertos = (p) => p.palavras.filter((w) => alvo.has(w)).length;

    const expressoes = glossario.filter((p) => novo(p) && p.palavras.length > 1 && acertos(p) > 0)
      .sort((a, b) => acertos(b) - acertos(a) || a.palavras.length - b.palavras.length || a.chave.localeCompare(b.chave))
      .slice(0, 6);
    expressoes.forEach((p) => usados.add(p.chave));
    const derivadas = glossario.filter((p) => novo(p) && p.palavras.length === 1
      && [...alvo].some((w) => w.length >= 4 && p.chave.startsWith(w) && p.chave.length <= w.length + 5)).slice(0, 4);
    derivadas.forEach((p) => usados.add(p.chave));

    // Mesmo tema: categoria dos sinais traduzidos; sorteio que muda a cada frase (mas é estável para ela)
    const porChave = new Map(glossario.map((p) => [p.chave, p]));
    const temas = new Set();
    sequencia.forEach((item) => {
      const p = porChave.get(textoComparavel(item.expressao_libras));
      if (p && !CATEGORIAS_FORA.has(p.categoria)) temas.add(p.categoria);
    });
    let semente = [...textoComparavel(entrada)].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
    const candidatos = glossario.filter((p) => novo(p) && temas.has(p.categoria));
    const doTema = [];
    while (candidatos.length && doTema.length < 8) {
      semente = (Math.imul(semente, 1103515245) + 12345) >>> 0;
      doTema.push(candidatos.splice(semente % candidatos.length, 1)[0]);
    }

    const frases = FRASES_EXEMPLO.filter((f) => !usados.has(textoComparavel(f)));
    const tema = temas.size === 1 ? `Mais em ${[...temas][0]}` : 'Do mesmo tema';
    return [
      { titulo: 'Com essas palavras', itens: [...expressoes, ...derivadas].map((p) => p.texto) },
      { titulo: tema, itens: doTema.map((p) => p.texto) },
      { titulo: 'Para experimentar', itens: frases.slice(0, 6) },
    ].filter((s) => s.itens.length);
  }

  const ICONES_SUGESTOES = {
    ampliar: '<svg class="icone-ampliar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>'
      + '<svg class="icone-reduzir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>',
    recolher: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg>',
    fechar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>',
  };

  function botaoSugestoes(acao, rotulo) {
    const botao = criar('button', { classe: 'sugestoes-acao', atributos: { type: 'button', 'data-acao': acao, 'aria-label': rotulo, title: rotulo } });
    botao.innerHTML = ICONES_SUGESTOES[acao]; // ícones fixos do próprio código
    return botao;
  }

  let contadorSugestoes = 0;
  async function mostrarSugestoes(balao, dados) {
    const secoes = montarSugestoes(dados, await carregarGlossario());
    const linha = balao.parentElement;
    if (!secoes.length || !balao.isConnected || !linha || !linha.classList.contains('msg-linha')) return;

    // Só uma caixa aberta por vez: as anteriores ficam recolhidas
    caixasSugestoes.forEach((c) => { if (c.caixa.isConnected) c.recolher(true); else caixasSugestoes.delete(c); });

    const idCorpo = `sugestoes-${++contadorSugestoes}`;
    const btnAmpliar = botaoSugestoes('ampliar', 'Ampliar sugestões');
    const btnRecolher = botaoSugestoes('recolher', 'Recolher sugestões');
    const btnFechar = botaoSugestoes('fechar', 'Fechar sugestões');
    btnAmpliar.setAttribute('aria-pressed', 'false');
    btnRecolher.setAttribute('aria-expanded', 'true');
    btnRecolher.setAttribute('aria-controls', idCorpo);

    const total = secoes.reduce((n, s) => n + s.itens.length, 0);
    const visiveis = Math.min(SUGESTOES_VISIVEIS, secoes[0].itens.length);
    const verMais = total > visiveis
      ? criar('button', { classe: 'sugestoes-mais', texto: `Ver mais (${total - visiveis})`, atributos: { type: 'button' } })
      : null;

    const corpo = criar('div', { classe: 'sugestoes-corpo', atributos: { id: idCorpo } }, [
      ...secoes.map((secao) => criar('section', { classe: 'sugestoes-secao' }, [
        criar('h3', { texto: secao.titulo }),
        criar('div', { classe: 'sugestoes-lista' }, secao.itens.map((item) => {
          const botao = criar('button', { classe: 'sugestao', texto: formatarSugestao(item), atributos: { type: 'button', title: `Traduzir “${formatarSugestao(item)}”` } });
          botao.addEventListener('click', () => traduzirTexto(item));
          return botao;
        })),
      ])),
      ...(verMais ? [verMais] : []),
    ]);

    const caixa = criar('aside', { classe: 'sugestoes', atributos: { 'aria-label': 'Sugestões de outras frases e palavras' } }, [
      criar('div', { classe: 'sugestoes-topo' }, [
        criar('p', { classe: 'sugestoes-titulo' }, [criar('span', { texto: '💡', atributos: { 'aria-hidden': 'true' } }), 'Experimente também']),
        btnAmpliar, btnRecolher, btnFechar,
      ]),
      corpo,
    ]);

    const reanimar = () => { corpo.classList.remove('surgir'); void corpo.offsetWidth; corpo.classList.add('surgir'); };
    function ampliar(sim) {
      caixa.classList.toggle('ampliado', sim);
      btnAmpliar.setAttribute('aria-pressed', String(sim));
      btnAmpliar.setAttribute('aria-label', sim ? 'Reduzir sugestões' : 'Ampliar sugestões');
      btnAmpliar.title = btnAmpliar.getAttribute('aria-label');
      if (sim) recolher(false);
      reanimar();
    }
    function recolher(sim) {
      caixa.classList.toggle('recolhido', sim);
      corpo.hidden = sim;
      btnRecolher.setAttribute('aria-expanded', String(!sim));
      btnRecolher.setAttribute('aria-label', sim ? 'Mostrar sugestões' : 'Recolher sugestões');
      btnRecolher.title = btnRecolher.getAttribute('aria-label');
      if (!sim) reanimar();
    }
    function fechar() {
      const tinhaFoco = caixa.contains(document.activeElement);
      const registro = [...caixasSugestoes].find((c) => c.caixa === caixa);
      if (registro) caixasSugestoes.delete(registro);
      const remover = () => {
        caixa.remove();
        if (tinhaFoco) (balao.querySelector('.btn-player:not([hidden])') || chatInput).focus();
      };
      if (movimentoReduzido() || !caixa.animate) return remover();
      caixa.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateX(-10px) scale(.96)' }],
        { duration: 200, easing: 'ease-in', fill: 'forwards' }).finished.then(remover, remover);
    }

    btnAmpliar.addEventListener('click', () => ampliar(!caixa.classList.contains('ampliado')));
    btnRecolher.addEventListener('click', () => recolher(!caixa.classList.contains('recolhido')));
    btnFechar.addEventListener('click', fechar);
    if (verMais) verMais.addEventListener('click', () => { ampliar(true); btnAmpliar.focus(); });

    linha.append(caixa);
    caixasSugestoes.add({ caixa, recolher });
    caixa.scrollIntoView({ block: 'nearest', behavior: movimentoReduzido() ? 'auto' : 'smooth' });
  }

  // ── Feedback ──────────────────────────────────────────────
  // 👍 registra que a tradução ajudou. 👎 pergunta qual sinal estava errado:
  // os sinais marcados deixam de ser usados nas próximas traduções DESTE usuário.
  async function enviarFeedbackServidor(corpo) {
    try {
      const resposta = await fetch('/feedback', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
        body: JSON.stringify(corpo),
      });
      const dados = await resposta.json().catch(() => null);
      return { ok: resposta.ok, status: resposta.status, dados };
    } catch (e) {
      return { ok: false, status: 0, dados: null };
    }
  }

  function avisoSessao() {
    return criar('span', { classe: 'feedback-aviso' }, [
      'Como você não entrou na sua conta, isso vale só nesta sessão. ',
      criar('a', { texto: 'Entrar', atributos: { href: '/login' } }),
      ' ou ',
      criar('a', { texto: 'criar conta', atributos: { href: '/register' } }),
      ' para guardar.',
    ]);
  }

  function criarFeedback({ texto, glosa, sequencia }) {
    const pergunta = criar('span', { classe: 'feedback-pergunta', texto: 'Esse era o resultado esperado?' });
    const sim = criar('button', { classe: 'feedback-botao', atributos: { type: 'button', 'aria-label': 'Sim, era o esperado' } }, ['👍 ', criar('span', { texto: 'Sim' })]);
    const nao = criar('button', { classe: 'feedback-botao', atributos: { type: 'button', 'aria-label': 'Não era o esperado', 'aria-expanded': 'false' } }, ['👎 ', criar('span', { texto: 'Não' })]);
    const linha = criar('div', { classe: 'feedback-inline' }, [pergunta, criar('span', { classe: 'feedback-botoes' }, [sim, nao])]);

    // Sinais da resposta, sem repetição, na mesma ordem do player
    const vistos = new Set();
    const sinais = [];
    sequencia.forEach((item, i) => {
      if (item.metodo === 'datilologia') return; // letras soletradas não são "sinal errado"
      const termo = normalizar(item.termo_original);
      const expressao = normalizar(item.expressao_libras);
      const chave = `${termo}\u0000${expressao}`;
      if (!termo || !expressao || vistos.has(chave)) return;
      vistos.add(chave);
      sinais.push({ termo, expressao, rotulo: `${i + 1}. ${item.expressao_libras}` });
    });

    const chips = sinais.map((s) => {
      const chip = criar('button', {
        classe: 'feedback-chip',
        texto: s.rotulo,
        atributos: { type: 'button', 'aria-pressed': 'false', title: `Termo da glosa: ${s.termo}` },
      });
      chip.addEventListener('click', () => {
        const marcado = chip.getAttribute('aria-pressed') !== 'true';
        chip.setAttribute('aria-pressed', String(marcado));
        enviarDetalhe.textContent = marcado || chips.some((c) => c.getAttribute('aria-pressed') === 'true')
          ? 'Enviar' : 'Enviar sem marcar';
      });
      return chip;
    });
    const enviarDetalhe = criar('button', { classe: 'btn-player btn-player-primario', texto: 'Enviar sem marcar', atributos: { type: 'button' } });
    const cancelar = criar('button', { classe: 'btn-player', texto: 'Cancelar', atributos: { type: 'button' } });
    const detalhe = criar('div', { classe: 'feedback-detalhe' }, [
      criar('p', { texto: 'Qual sinal não ficou certo? Toque para marcar:' }),
      criar('div', { classe: 'feedback-sinais' }, chips),
      criar('div', { classe: 'feedback-acoes' }, [enviarDetalhe, cancelar]),
    ]);
    detalhe.hidden = true;

    const status = criar('div', { classe: 'feedback-status', atributos: { role: 'status' } });
    const caixa = criar('div', { classe: 'feedback-caixa' }, [linha, detalhe, status]);

    function bloquear(sim_) { [sim, nao, enviarDetalhe, cancelar, ...chips].forEach((b) => { b.disabled = sim_; }); }

    function concluir(foiUtil, marcados) {
      linha.hidden = true;
      detalhe.hidden = true;
      const partes = [];
      if (foiUtil) {
        partes.push(criar('p', { texto: 'Obrigado! Que bom que a tradução ajudou. 💙' }));
      } else if (marcados.length > 0) {
        const nomes = marcados.map((s) => s.expressao.toUpperCase()).join(', ');
        partes.push(criar('p', {
          texto: marcados.length === 1
            ? `Entendido. Nas suas próximas traduções não vamos mais usar o sinal ${nomes}.`
            : `Entendido. Nas suas próximas traduções não vamos mais usar os sinais ${nomes}.`,
        }));
        const repetir = criar('button', { classe: 'btn-player btn-player-primario', texto: '↻ Traduzir de novo', atributos: { type: 'button' } });
        repetir.addEventListener('click', () => traduzirTexto(texto));
        partes.push(repetir);
      } else {
        partes.push(criar('p', { texto: 'Obrigado pelo retorno! Ele nos ajuda a melhorar as traduções.' }));
      }
      if (USUARIO_LOGADO && !foiUtil && marcados.length > 0) {
        partes.push(criar('span', { classe: 'feedback-aviso' }, [
          'Você pode desfazer isso em ', criar('a', { texto: 'Histórico', atributos: { href: '/historico#sinais-ocultos' } }), '.',
        ]));
      }
      if (!USUARIO_LOGADO) partes.push(avisoSessao());
      status.replaceChildren(...partes);
      status.classList.remove('surgir');
      void status.offsetWidth; // reinicia a animação de entrada
      status.classList.add('surgir');
    }

    async function enviar(foiUtil, marcados = []) {
      if (!USUARIO_LOGADO) {
        guardarExclusoes(marcados);
        salvarNaSessao();
        return concluir(foiUtil, marcados);
      }

      bloquear(true);
      status.textContent = 'Enviando…';
      const r = await enviarFeedbackServidor({
        texto,
        glosa,
        foi_util: foiUtil,
        sinais_incorretos: marcados.map(({ termo, expressao }) => ({ termo, expressao })),
      });
      if (r.ok) {
        guardarExclusoes(r.dados?.exclusoes || marcados);
        return concluir(foiUtil, marcados);
      }
      bloquear(false);
      status.textContent = r.status === 401 || r.status === 403
        ? 'Sua sessão expirou. Recarregue a página e tente novamente.'
        : (r.dados?.mensagem || 'Não foi possível enviar o feedback agora. Tente novamente.');
    }

    sim.addEventListener('click', () => { sim.classList.add('pop'); enviar(true); });
    nao.addEventListener('click', () => {
      if (sinais.length === 0) return enviar(false);
      const abrir = detalhe.hidden;
      detalhe.hidden = !abrir;
      nao.setAttribute('aria-expanded', String(abrir));
      if (abrir) chips[0].focus();
    });
    cancelar.addEventListener('click', () => {
      detalhe.hidden = true;
      nao.setAttribute('aria-expanded', 'false');
      nao.focus();
    });
    enviarDetalhe.addEventListener('click', () => {
      const marcados = sinais.filter((_, i) => chips[i].getAttribute('aria-pressed') === 'true');
      enviar(false, marcados);
    });
    return caixa;
  }

  // ── Histórico (somente usuário logado; visitantes veem o convite em /historico) ──
  // Salva a tradução no histórico. Se falhar, a tradução continua normalmente.
  function salvarHistorico(texto, glosa, sequencia) {
    if (!USUARIO_LOGADO || !texto) return;
    fetch('/historico', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
      body: JSON.stringify({
        texto,
        glosa: glosa || '',
        sequencia: (sequencia || []).map((item) => ({
          termo_original: item.termo_original,
          expressao_libras: item.expressao_libras,
          url: item.url,
        })),
      }),
    }).catch((err) => console.warn('Não foi possível salvar no histórico:', err));
  }

  // opcoes.demo: a demonstração da primeira visita não vai para o histórico da pessoa
  function tratarResultadoTraducao(resposta, resultado, entrada, opcoes = {}) {
    const { ok, dados } = resultado;
    const { soletraveis, outras } = palavrasSemSinal(dados);
    if (ok && dados && dados.status === 'success' && (dados.sequencia || []).length > 0) {
      renderTraducao(resposta, dados, entrada);
      if (!opcoes.demo) salvarHistorico(entrada, dados.glosa, dados.sequencia);
    } else if (dados && dados.codigo === 'SEM_SINAIS' && soletraveis.length && entrada) {
      // Nenhuma palavra com sinal, mas dá para soletrar: em vez do aviso de erro, a pergunta
      const elementos = opcoesSemSinal(entrada, soletraveis, outras);
      resposta.responder(elementos);
      avatar('sem-sinal');
      anunciar(elementos[0].textContent);
    } else {
      const mensagem = mensagemDeErro(resultado);
      resposta.erro(mensagem);
      avatar('sem-sinal');
      anunciar(typeof mensagem === 'string' ? mensagem : mensagem.textContent);
    }
  }

  // ── Tradução por texto ────────────────────────────────────
  // origem: elemento de onde o texto saiu (campo ou exemplo), para ele "voar" até o balão.
  // opcoes.soletrar: palavras sem sinal que a pessoa escolheu ver soletradas (a escolha aparece como
  // mensagem dela). Devolve true se o serviço respondeu.
  async function traduzirTexto(textoBruto, origem = null, opcoes = {}) {
    const texto = (textoBruto || '').trim().slice(0, LIMITE_TEXTO);
    if (!texto || traduzindo || gravando) return false;
    const soletrar = Array.isArray(opcoes.soletrar) ? opcoes.soletrar : [];
    traduzindo = true; // já aqui: a transição de abertura leva um quadro e não pode haver envio duplo
    // Uma pergunta nova pausa o sinal que estava tocando: o "traduzindo…" não disputa o olhar com ele
    if (playerAtivo) playerAtivo.pausar();

    let enviada;
    let resposta;
    await abrirConversa(() => {
      searchInput.value = '';
      chatInput.value = '';
      statusInicio.textContent = '';
      atualizarBotaoChat();
      enviada = mensagemUsuario([criar('p', {
        classe: 'msg-texto',
        texto: soletrar.length ? `🔤 Soletrar ${listaDePalavras(soletrar)}` : texto,
      })]);
      resposta = mensagemBot();
      return enviada.balao.querySelector('.msg-texto');
    }, origem, opcoes);
    atualizarBloqueios();
    try {
      const resultado = await chamarApi('/traduzir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ texto, exclusoes: listaExclusoes(), ...(soletrar.length ? { soletrar } : {}) }),
      });
      enviada.respondida();
      tratarResultadoTraducao(resposta, resultado, texto, opcoes);
      return resultado.status > 0 && resultado.status < 500; // sem rede ou serviço fora: não foi feita
    } finally {
      traduzindo = false;
      atualizarBloqueios();
      chatInput.focus({ preventScroll: true });
    }
  }

  searchForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!searchInput.value.trim()) {
      statusInicio.textContent = 'Digite uma palavra ou frase para traduzir.';
      searchInput.focus();
      return;
    }
    traduzirTexto(searchInput.value, searchInput);
  });
  chatForm.addEventListener('submit', (e) => {
    e.preventDefault();
    traduzirTexto(chatInput.value);
  });
  exemplos.forEach((botao) => botao.addEventListener('click', () => traduzirTexto(botao.dataset.exemplo, botao)));

  // ── Tradução por áudio (mensagem de voz) ──────────────────
  function extensaoDoAudio(mimeType) {
    if (mimeType.includes('mp4')) return 'm4a';
    if (mimeType.includes('ogg')) return 'ogg';
    return 'webm';
  }

  const formatarDuracao = (s) => `0:${String(Math.max(0, Math.round(s))).padStart(2, '0')}`;

  // Balão de voz do usuário: dá para ouvir de novo o que foi gravado; a transcrição aparece embaixo.
  // 4.4 A onda é a da gravação de verdade (volumes medidos enquanto a pessoa falava) e acende
  // conforme o áudio toca. Sem medição (navegador sem Web Audio), usa uma onda ilustrativa.
  const BARRAS_ONDA = 22;
  function ondaDosNiveis(niveis) {
    if (!niveis || niveis.length < 4) return null;
    const pico = Math.max(...niveis, 0.05);
    return Array.from({ length: BARRAS_ONDA }, (_, i) => {
      const ini = Math.floor((i * niveis.length) / BARRAS_ONDA);
      const fim = Math.max(ini + 1, Math.floor(((i + 1) * niveis.length) / BARRAS_ONDA));
      return Math.max(...niveis.slice(ini, fim)) / pico; // 0 a 1, relativo ao trecho mais alto
    });
  }

  function balaoDeVoz(blob, segundos, niveis) {
    const url = URL.createObjectURL(blob);
    audiosGravados.push(url);
    const audio = new Audio(url);
    const botao = criar('button', { classe: 'voz-play', texto: '▶', atributos: { type: 'button', 'aria-label': 'Ouvir o áudio gravado' } });
    const onda = ondaDosNiveis(niveis);
    const barras = Array.from({ length: BARRAS_ONDA }, (_, i) => criar('i', {
      atributos: { style: `height:${onda ? 14 + Math.round(onda[i] * 86) : 30 + Math.round(Math.abs(Math.sin(i * 1.7)) * 70)}%` },
    }));
    const barra = criar('span', { classe: `voz-onda${onda ? ' real' : ''}`, atributos: { 'aria-hidden': 'true' } }, barras);
    const duracao = criar('span', { classe: 'voz-duracao', texto: formatarDuracao(segundos) });
    botao.addEventListener('click', () => {
      if (audio.paused) { if (playerAtivo) playerAtivo.pausar(); audio.play(); } else { audio.pause(); }
    });
    audio.addEventListener('play', () => { botao.textContent = '❚❚'; botao.setAttribute('aria-label', 'Pausar o áudio'); });
    const parado = () => { botao.textContent = '▶'; botao.setAttribute('aria-label', 'Ouvir o áudio gravado'); };
    audio.addEventListener('pause', parado);
    audio.addEventListener('ended', parado);
    // As barras já tocadas acendem
    const acender = () => {
      const fracao = audio.duration && Number.isFinite(audio.duration) ? audio.currentTime / audio.duration : 0;
      const ate = audio.ended ? 0 : Math.round(fracao * BARRAS_ONDA);
      barras.forEach((b, i) => b.classList.toggle('tocada', i < ate));
    };
    audio.addEventListener('timeupdate', acender);
    audio.addEventListener('ended', acender);
    const transcricao = criar('p', { classe: 'msg-transcricao', texto: 'transcrevendo…' });
    return {
      conteudo: [criar('div', { classe: 'voz' }, [criar('span', { classe: 'voz-mic', texto: '🎤', atributos: { 'aria-hidden': 'true' } }), botao, barra, duracao]), transcricao],
      transcrito(texto) {
        transcricao.textContent = texto ? `“${texto}”` : 'Não deu para entender o áudio.';
        transcricao.classList.toggle('falhou', !texto);
      },
    };
  }

  let pararGravacao = null;

  // Volume real do microfone durante a gravação (Web Audio): o anel em volta do botão cresce com a
  // voz e o medidor no campo "Gravando…" enche. Se o anel não se mexe, o microfone não está captando.
  // Devolve { parar, niveis } (niveis: volume de cada quadro, para a onda do balão de voz), ou null
  // sem suporte; aí fica o pulso de antes.
  function medirVolume(stream) {
    const Contexto = window.AudioContext || window.webkitAudioContext;
    if (!Contexto) return null;
    try {
      const contexto = new Contexto();
      if (contexto.state === 'suspended') contexto.resume().catch(() => {}); // sem isso, o começo da gravação mede silêncio
      const analisador = contexto.createAnalyser();
      analisador.fftSize = 512;
      contexto.createMediaStreamSource(stream).connect(analisador);
      const amostras = new Uint8Array(analisador.fftSize);
      let suave = 0;
      let quadro = 0;
      const niveis = [];
      chatAcao.classList.add('com-nivel');
      // Volume (RMS) do instante, de 0 a 1
      const ler = () => {
        analisador.getByteTimeDomainData(amostras);
        let soma = 0;
        for (let i = 0; i < amostras.length; i++) { const d = (amostras[i] - 128) / 128; soma += d * d; }
        return Math.min(1, Math.sqrt(soma / amostras.length) * 5);
      };
      // Anel e medidor: a cada quadro
      const medir = () => {
        suave = suave * 0.7 + ler() * 0.3; // sem tremer a cada quadro
        chatForm.style.setProperty('--nivel', suave.toFixed(3));
        quadro = requestAnimationFrame(medir);
      };
      medir();
      // Onda do balão: 10 amostras por segundo (intervalo, que continua mesmo com a aba em segundo plano)
      const guardar = () => { if (niveis.length < 600) niveis.push(ler()); };
      guardar();
      const reserva = setInterval(guardar, 100);
      return {
        niveis,
        parar() {
          cancelAnimationFrame(quadro);
          clearInterval(reserva);
          chatAcao.classList.remove('com-nivel');
          chatForm.style.removeProperty('--nivel');
          contexto.close().catch(() => {});
        },
      };
    } catch (e) {
      return null;
    }
  }

  async function gravarAudio() {
    if (gravando) { if (pararGravacao) pararGravacao(); return; } // tocar de novo encerra e envia antes dos 5 s
    if (traduzindo) return;

    let stream;
    try {
      stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch (e) {
      if (conversa.hidden) statusInicio.textContent = 'Não foi possível acessar o microfone. Verifique a permissão do navegador.';
      else mensagemBot().erro('Não foi possível acessar o microfone. Verifique a permissão do navegador.');
      return;
    }

    gravando = true; // antes da transição de abertura, para não aceitar um segundo clique
    await abrirConversa();
    if (playerAtivo) playerAtivo.pausar();
    atualizarBloqueios();
    atualizarBotaoChat();
    chatInput.hidden = true;
    gravandoEl.hidden = false;

    const partes = [];
    let tipo = 'audio/webm';
    let gravou = false;
    let relogio = null;
    let medidor = null;
    const comeco = Date.now();
    try {
      const recorder = new MediaRecorder(stream);
      recorder.ondataavailable = (e) => { if (e.data.size) partes.push(e.data); };
      const terminou = new Promise((resolve) => { recorder.onstop = resolve; });
      pararGravacao = () => { if (recorder.state !== 'inactive') recorder.stop(); };
      recorder.start();
      const atualizarRelogio = () => {
        const restante = Math.ceil((DURACAO_GRAVACAO_MS - (Date.now() - comeco)) / 1000);
        gravandoTxt.textContent = `Gravando… fale agora · ${formatarDuracao(Math.max(restante, 0))}`;
      };
      atualizarRelogio();
      relogio = setInterval(atualizarRelogio, 250);
      medidor = medirVolume(stream);
      window.tlVibrar?.(15); // começou a gravar
      setTimeout(pararGravacao, DURACAO_GRAVACAO_MS);
      await terminou;
      tipo = recorder.mimeType || tipo;
      gravou = partes.length > 0;
    } catch (e) {
      console.warn('Falha na gravação:', e);
    } finally {
      clearInterval(relogio);
      if (medidor) medidor.parar();
      window.tlVibrar?.([10, 60, 10]); // parou de gravar
      pararGravacao = null;
      stream.getTracks().forEach((t) => t.stop());
      gravandoEl.hidden = true;
      chatInput.hidden = false;
    }

    gravando = false;
    atualizarBotaoChat();
    if (!gravou) {
      atualizarBloqueios();
      mensagemBot().erro('Não foi possível gravar o áudio neste navegador.');
      return;
    }

    const blob = new Blob(partes, { type: tipo });
    const voz = balaoDeVoz(blob, (Date.now() - comeco) / 1000, medidor ? medidor.niveis : null);
    const enviada = mensagemUsuario(voz.conteudo);
    const resposta = mensagemBot();

    const formData = new FormData();
    formData.append('file', blob, `gravacao.${extensaoDoAudio(tipo)}`);
    formData.append('exclusoes', JSON.stringify(listaExclusoes()));

    traduzindo = true;
    atualizarBloqueios();
    try {
      // /traduzir/voz já devolve a tradução: não é preciso chamar /traduzir de novo
      const resultado = await chamarApi('/traduzir/voz', { method: 'POST', body: formData });
      const transcrito = resultado.dados?.texto_transcrito;
      voz.transcrito(transcrito);
      enviada.respondida();
      tratarResultadoTraducao(resposta, resultado, transcrito || '');
    } finally {
      traduzindo = false;
      atualizarBloqueios();
    }
  }

  recordBtn.addEventListener('click', gravarAudio);
  chatAcao.addEventListener('click', (e) => {
    if (chatAcao.dataset.modo === 'enviar') return; // o submit do formulário cuida
    e.preventDefault();
    gravarAudio();
  });
  atualizarBotaoChat();

  // ── Tradução automática pela URL (?word=) ─────────────────
  const palavraUrl = new URLSearchParams(window.location.search).get('word');
  if (palavraUrl) traduzirTexto(palavraUrl.slice(0, LIMITE_TEXTO), null, { chegada: true });

  // ── Demonstração guiada (botão "Ver um exemplo") ──────────
  // Só quando a pessoa pede: o campo "digita sozinho" eu gosto de café, a tradução acontece (com a glosa) e
  // um balão convida: "Agora é sua vez". Antes rodava sozinha na primeira visita, o que começava uma
  // tradução sem ninguém pedir (e gastava uma chamada à API a cada visitante novo).
  // Qualquer tecla, clique ou toque durante a digitação cancela. Não entra no histórico da pessoa.
  // Com animações reduzidas, a frase aparece de uma vez em vez de ser digitada.
  const espera = (ms) => new Promise((r) => { setTimeout(r, ms); });

  function dicaSuaVez() {
    const dica = criar('p', { classe: 'dica-vez', atributos: { role: 'status' } }, [
      criar('strong', { texto: 'Agora é sua vez!' }), ' Escreva uma frase ou toque no microfone.',
    ]);
    conversa.append(dica);
    const sumir = () => {
      if (!dica.isConnected) return;
      dica.classList.add('saindo');
      setTimeout(() => dica.remove(), 300);
    };
    chatInput.addEventListener('input', sumir, { once: true });
    setTimeout(sumir, 9000);
    chatInput.focus({ preventScroll: true });
  }

  let demonstrando = false;
  async function demonstracao() {
    if (demonstrando) return;
    demonstrando = true;
    try { await rodarDemonstracao(); } finally { demonstrando = false; }
  }

  async function rodarDemonstracao() {
    // Todos os sinais existem no banco e a glosa fica visível: o "de" cai e a ordem muda (CAFÉ EU GOSTAR).
    // ("bom dia" não serve: o banco não tem o sinal BOM, e a tradução sairia só DIA.)
    const FRASE = 'eu gosto de café';
    let cancelada = false;
    const cancelar = () => { cancelada = true; };
    // A pessoa já começou a usar (conversa aberta ou traduzindo): a demonstração não se intromete
    const emUso = () => !conversa.hidden || traduzindo || gravando;
    const eventos = ['keydown', 'pointerdown', 'wheel', 'touchstart'];
    searchInput.value = '';
    anunciar(`Exemplo: traduzindo “${FRASE}”. Aperte qualquer tecla para cancelar.`);
    if (movimentoReduzido()) {
      searchInput.value = FRASE;
    } else {
      eventos.forEach((ev) => window.addEventListener(ev, cancelar, { capture: true, once: true }));
      await espera(250);
      for (const letra of FRASE) {
        if (cancelada || emUso()) break;
        searchInput.value += letra;
        await espera(120);
      }
    }
    eventos.forEach((ev) => window.removeEventListener(ev, cancelar, { capture: true }));
    if (cancelada || emUso()) {
      if (FRASE.startsWith(searchInput.value)) searchInput.value = ''; // limpa só o que a demonstração escreveu
      return;
    }
    await espera(350);
    if (emUso()) { searchInput.value = ''; return; }
    await traduzirTexto(FRASE, searchInput, { demo: true });
    dicaSuaVez();
  }

  document.getElementById('verExemplo').addEventListener('click', demonstracao);
})();
</script>

