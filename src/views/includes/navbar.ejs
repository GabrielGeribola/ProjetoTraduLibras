  <div class="sidebar-header">
    <img
      src="https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/logo-clara.png"
      alt="Logo TraduLibras"
      class="nav-img"
    />
  </div>
  <div class="nav-linha" style="margin-top: 20px;"></div>

  <a href="/home" class="nav-link">
    <img src="https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/icon-traducao.png" class="nav-icon" alt=""/>
    <span class="link-text">Tradução</span>
  </a>
  <%# Histórico aparece para todos; para visitantes, a página explica que é preciso entrar %>
  <a href="/historico" class="nav-link">
    <svg class="nav-icon" viewBox="-4 -4 32 32" fill="none" stroke="#000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 12a9 9 0 1 0 3-6.7"/>
      <polyline points="3 3 3 8 8 8"/>
      <polyline points="12 7 12 12 15.5 14"/>
    </svg>
    <span class="link-text">Histórico</span>
    <% if (!user) { %>
      <svg class="nav-cadeado" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
      </svg>
