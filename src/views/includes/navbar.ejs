<%# Logo com o texto escuro, para fundos claros (Entrar, Cadastro, senha no modo claro).
    O logo-clara.png tem texto branco; esta matriz troca o branco pelo grafite da marca (#373735) e
    mantém o laranja da mão igual: cor nova = cor + (grafite − 1) × (azul − 0,251) / 0,749.
    O laranja tem azul ≈ 0,251 (não muda) e o branco tem azul 1 (vira grafite). Usado no styleteste.css. %>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <filter id="logo-texto-escuro" color-interpolation-filters="sRGB">
    <feColorMatrix type="matrix" values="1 0 -1.0467 0 0.2627
                                         0 1 -1.0467 0 0.2627
                                         0 0 -0.0574 0 0.2654
                                         0 0  0      1 0"/>
  </filter>
</svg>

<!-- Overlay -->
<div class="overlay" id="overlay"></div>

<!-- Botão hamburguer -->
<button class="hamburger-btn" id="hamburgerBtn" aria-label="Abrir menu" aria-expanded="false" aria-controls="sidebar">
  <span></span><span></span><span></span>
</button>

<!-- Botão configurações (engrenagem) -->
<button class="settings-btn" id="settingsBtn" aria-label="Configurações" aria-expanded="false" aria-controls="settingsPanel">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="3"/>
    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
  </svg>
</button>

<!-- Painel de configurações -->
<div class="settings-panel" id="settingsPanel" inert>
  <div class="settings-header">
    <span>Configurações</span>
    <button class="settings-close" id="settingsClose" aria-label="Fechar">✕</button>
  </div>

  <!-- Modo escuro -->
  <div class="settings-item">
    <div class="settings-item-info">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
        <path d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z"/>
      </svg>
      <span id="rotuloModoEscuro">Modo escuro</span>
    </div>
    <label class="toggle-switch">
      <input type="checkbox" id="darkModeToggle" role="switch" aria-labelledby="rotuloModoEscuro">
      <span class="toggle-track"><span class="toggle-thumb">
        <svg class="toggle-icone toggle-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="toggle-icone toggle-lua" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
        </svg>
      </span></span>
    </label>
  </div>

  <!-- Tema automático: segue o claro/escuro do sistema -->
  <div class="settings-item settings-item-sub">
    <div class="settings-item-info">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/>
      </svg>
      <span id="rotuloTemaAuto">Seguir o sistema</span>
    </div>
    <label class="toggle-switch">
      <input type="checkbox" id="autoThemeToggle" role="switch" aria-labelledby="rotuloTemaAuto">
      <span class="toggle-track"><span class="toggle-thumb"></span></span>
    </label>
  </div>

  <div class="settings-divider"></div>

  <!-- Tamanho da fonte -->
  <div class="settings-item settings-item-col">
    <div class="settings-item-info">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
        <polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/>
      </svg>
      <span>Tamanho da fonte</span>
    </div>
    <div class="font-size-control">
      <button class="font-size-btn" id="fontDecrease" aria-label="Diminuir fonte">A−</button>
      <span class="font-size-label" id="fontLabel">Médio</span>
      <button class="font-size-btn" id="fontIncrease" aria-label="Aumentar fonte">A+</button>
    </div>
  </div>

  <div class="settings-divider"></div>

  <!-- Reduzir animações (padrão: o que o sistema operacional pede) -->
  <div class="settings-item">
    <div class="settings-item-info">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true">
        <path d="M2 12c2.5-4 5-4 7.5 0s5 4 7.5 0 3.5-2.7 5-1.5"/>
      </svg>
      <span id="rotuloMovimento">Reduzir animações</span>
    </div>
    <label class="toggle-switch">
      <input type="checkbox" id="motionToggle" role="switch" aria-labelledby="rotuloMovimento">
      <span class="toggle-track"><span class="toggle-thumb"></span></span>
    </label>
  </div>

  <!-- Vibração (celular): toque curto ao gravar e quando a tradução chega. Desligada por padrão.
       Só aparece em aparelho de toque cujo navegador vibra (no computador e no iPhone não teria efeito). -->
  <div class="settings-item" id="itemVibracao" hidden>
    <div class="settings-item-info">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true">
        <rect x="7" y="3" width="10" height="18" rx="2"/><path d="M3 8v8M21 8v8"/>
      </svg>
      <span id="rotuloVibracao">Vibração <small>(celular)</small></span>
    </div>
    <label class="toggle-switch">
      <input type="checkbox" id="vibrationToggle" role="switch" aria-labelledby="rotuloVibracao">
      <span class="toggle-track"><span class="toggle-thumb"></span></span>
    </label>
  </div>
</div>

<!-- Sidebar -->
