    <svg class="nav-icon" viewBox="-4 -4 32 32" fill="none" stroke="#000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/>
      <circle cx="7.5" cy="7.5" r="1.5"/>
    </svg>
    <span class="link-text">Planos</span>
  </a>

  <div class="nav-linha"></div>

  <a href="/sobre" class="nav-link">
    <img src="https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/icon-sobre.png" class="nav-icon" alt=""/>
    <span class="link-text">Sobre</span>
  </a>
  <a href="/ajuda" class="nav-link">
    <img src="https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/icon-ajuda.png" class="nav-icon" alt=""/>
    <span class="link-text">Ajuda</span>
  </a>

  <% if (user && user.papel === 'admin') { %>
    <div class="nav-linha"></div>
    <a href="/admin" class="nav-link nav-admin">
      <svg class="nav-icon" viewBox="-4 -4 32 32" fill="none" stroke="#000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5z"/>
