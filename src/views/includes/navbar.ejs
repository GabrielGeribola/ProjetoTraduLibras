</nav>

<script>
  // Tema e tamanho de fonte salvos são aplicados no <head> (includes/head.ejs)

  // ── Hamburger ────────────────────────────────────────────
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const sidebar      = document.getElementById('sidebar');
  const overlay      = document.getElementById('overlay');
  const settingsPanel = document.getElementById('settingsPanel');

  // O botão do menu não some: vira um "X" e desliza para o canto do menu aberto (CSS .hamburger-btn.active)
  function openSidebar() {
    fecharConfig();
    sidebar.classList.add('open');
    overlay.classList.add('visible');
    hamburgerBtn.classList.add('active');
    settingsBtn.classList.add('hidden');
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    hamburgerBtn.setAttribute('aria-label', 'Fechar menu');
    sidebar.setAttribute('aria-hidden', 'false');
    sidebar.inert = false;
  }

  function closeSidebar() {
    sidebar.classList.remove('open');
    overlay.classList.remove('visible');
    hamburgerBtn.classList.remove('active');
    settingsBtn.classList.remove('hidden');
    hamburgerBtn.setAttribute('aria-expanded', 'false');
    hamburgerBtn.setAttribute('aria-label', 'Abrir menu');
    sidebar.setAttribute('aria-hidden', 'true');
    sidebar.inert = true;
  }

  hamburgerBtn.addEventListener('click', () => {
    sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
  });

  overlay.addEventListener('click', () => {
    closeSidebar();
    fecharConfig();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeSidebar(); fecharConfig(); }
  });

  document.querySelectorAll('.nav-link').forEach(link => {
    if (window.location.pathname.startsWith(link.getAttribute('href'))) {
      link.classList.add('active');
    }
  });

  // ── Configurações — painel ────────────────────────────────
  // aria-expanded também gira a engrenagem (CSS .settings-btn[aria-expanded="true"])
  function abrirConfig() {
    closeSidebar();
    settingsPanel.classList.add('open');
    settingsPanel.inert = false;
    settingsBtn.setAttribute('aria-expanded', 'true');
  }
  function fecharConfig() {
    settingsPanel.classList.remove('open');
    settingsPanel.inert = true;
    settingsBtn.setAttribute('aria-expanded', 'false');
  }
  settingsBtn.addEventListener('click', () => {
    settingsPanel.classList.contains('open') ? fecharConfig() : abrirConfig();
  });
  settingsClose.addEventListener('click', fecharConfig);

  // ── Dark Mode ─────────────────────────────────────────────
  const darkToggle = document.getElementById('darkModeToggle');
  const root       = document.documentElement;

  darkToggle.checked = root.getAttribute('data-theme') === 'dark';

  // Tema salvo: 'dark', 'light' ou 'auto' (segue o sistema; aplicado antes da pintura em head.ejs)
  const autoToggle = document.getElementById('autoThemeToggle');
  const sistemaEscuro = window.matchMedia('(prefers-color-scheme: dark)');
  const lerTema = () => { try { return localStorage.getItem('theme'); } catch (e) { return null; } };
  const salvarTema = (valor) => { try { localStorage.setItem('theme', valor); } catch (e) { /* armazenamento indisponível */ } };
  autoToggle.checked = lerTema() === 'auto';

  // Troca o tema como um "eclipse": o novo se espalha em círculo a partir de `origem`.
  // Troca simples (sem círculo) com animações reduzidas ou se houver um vídeo de sinal tocando.
  function trocarTema(escuro, origem) {
    darkToggle.checked = escuro;
    if ((root.getAttribute('data-theme') === 'dark') === escuro) return;
    const pintar = () => { if (escuro) root.setAttribute('data-theme', 'dark'); else root.removeAttribute('data-theme'); };
    const videoTocando = [...document.querySelectorAll('video')].some((v) => !v.paused && !v.ended);
    if (!document.startViewTransition || window.tlMovimentoReduzido() || videoTocando || document.hidden) { pintar(); return; }

    const caixa = (origem || settingsBtn).getBoundingClientRect();
    const x = caixa.left + caixa.width / 2;
    const y = caixa.top + caixa.height / 2;
    const raio = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
    root.classList.add('vt-tema'); // CSS: sem nomes nem transições de cor, para o círculo valer para tudo
    const transicao = document.startViewTransition(pintar);
    transicao.ready.then(() => {
      root.animate({ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${raio}px at ${x}px ${y}px)`] },
        { duration: 620, easing: 'cubic-bezier(.4, 0, .2, 1)', pseudoElement: '::view-transition-new(root)' });
    }).catch(() => {});
    transicao.finished.finally(() => root.classList.remove('vt-tema'));
  }

  // Escolher claro/escuro à mão desliga o "Seguir o sistema"
  darkToggle.addEventListener('change', () => {
    autoToggle.checked = false;
    salvarTema(darkToggle.checked ? 'dark' : 'light');
    trocarTema(darkToggle.checked, darkToggle.parentElement);
  });
  autoToggle.addEventListener('change', () => {
    if (autoToggle.checked) {
      salvarTema('auto');
      trocarTema(sistemaEscuro.matches, autoToggle.parentElement);
    } else {
      salvarTema(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'); // fica como está
    }
  });
  // O sistema mudou (ex.: anoiteceu e o celular trocou para escuro): o site acompanha, se estiver no automático
  sistemaEscuro.addEventListener('change', (e) => {
    if (lerTema() === 'auto') trocarTema(e.matches, settingsBtn);
  });

  // ── Vibração ──────────────────────────────────────────────
  const vibrationToggle = document.getElementById('vibrationToggle');
  const podeVibrar = typeof navigator.vibrate === 'function' && window.matchMedia('(pointer: coarse)').matches;
  document.getElementById('itemVibracao').hidden = !podeVibrar;
  try { vibrationToggle.checked = localStorage.getItem('vibracao') === 'on'; } catch (e) { /* armazenamento indisponível */ }
  vibrationToggle.addEventListener('change', () => {
    try { localStorage.setItem('vibracao', vibrationToggle.checked ? 'on' : 'off'); } catch (e) { /* armazenamento indisponível */ }
    window.tlVibrar(20); // amostra ao ligar
  });

  // ── Tamanho da fonte ──────────────────────────────────────
  const SIZES  = ['pequeno', 'medio', 'grande', 'extra'];
  const LABELS = { pequeno: 'Pequeno', medio: 'Médio', grande: 'Grande', extra: 'Extra' };

  const fontDecrease = document.getElementById('fontDecrease');
  const fontIncrease = document.getElementById('fontIncrease');
  const fontLabel    = document.getElementById('fontLabel');

  function getCurrentSizeIndex() {
    const current = root.getAttribute('data-font-size') || 'medio';
    return SIZES.indexOf(current);
  }

  function applyFontSize(size) {
    root.setAttribute('data-font-size', size);
    localStorage.setItem('fontSize', size);
    fontLabel.textContent = LABELS[size];
    fontDecrease.disabled = SIZES.indexOf(size) === 0;
    fontIncrease.disabled = SIZES.indexOf(size) === SIZES.length - 1;
  }

  // Inicializa label e estado dos botões
  applyFontSize(root.getAttribute('data-font-size') || 'medio');

  fontDecrease.addEventListener('click', () => {
    const idx = getCurrentSizeIndex();
    if (idx > 0) applyFontSize(SIZES[idx - 1]);
  });

  fontIncrease.addEventListener('click', () => {
    const idx = getCurrentSizeIndex();
    if (idx < SIZES.length - 1) applyFontSize(SIZES[idx + 1]);
  });

  // ── Reduzir animações ─────────────────────────────────────
  // Começa marcado se o sistema já pede menos movimento; a escolha feita aqui vale só neste site.
  const motionToggle = document.getElementById('motionToggle');
  motionToggle.checked = window.tlMovimentoReduzido();
  motionToggle.addEventListener('change', () => {
    const valor = motionToggle.checked ? 'reduce' : 'full';
    root.setAttribute('data-motion', valor);
    try { localStorage.setItem('motion', valor); } catch (e) { /* armazenamento indisponível */ }
  });
</script>
<script src="/assets/js/movimento.js" defer></script>
