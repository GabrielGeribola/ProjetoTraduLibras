<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <% const descricaoSite = 'Tradutor de português para Libras: escreva ou fale uma frase e veja os sinais em vídeo, um por um. Glossário, cursos e planos para escolas, empresas e ONGs.'; %>
  <title><%= typeof tituloAba !== 'undefined' && tituloAba ? tituloAba + ' · ' : '' %>TraduLibras</title>
  <meta name="description" content="<%= descricaoSite %>">
  <meta name="theme-color" content="#eae8e1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#030303" media="(prefers-color-scheme: dark)">

  <%# Ícones (a mão do logo sobre o grafite da marca) %>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <%# Prévia do link ao compartilhar (WhatsApp, redes sociais) %>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="TraduLibras">
  <meta property="og:title" content="<%= typeof tituloAba !== 'undefined' && tituloAba ? tituloAba + ' · TraduLibras' : 'TraduLibras · Português para Libras' %>">
  <meta property="og:description" content="<%= descricaoSite %>">
  <% if (typeof urlSite !== 'undefined' && urlSite) { %>
    <meta property="og:image" content="<%= urlSite %>/favicon-512.png">
  <% } %>
  <meta name="twitter:card" content="summary">

  <script>
    // Com JavaScript: as animações de entrada ao rolar podem esconder o conteúdo até ele aparecer
    document.documentElement.classList.add('js');
    // Aplica tema e tamanho de fonte salvos antes de pintar a página (evita o "piscar" do modo escuro)
    (function () {
      try {
        // Tema: 'dark', 'light' ou 'auto' (segue o claro/escuro do sistema)
        var tema = localStorage.getItem('theme');
        if (tema === 'dark' || (tema === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        var tamanho = localStorage.getItem('fontSize');
        if (tamanho) document.documentElement.setAttribute('data-font-size', tamanho);
        // "Reduzir animações" das configurações: 'reduce' ou 'full'. Sem escolha, segue o sistema.
        var movimento = localStorage.getItem('motion');
        if (movimento === 'reduce' || movimento === 'full') document.documentElement.setAttribute('data-motion', movimento);
      } catch (e) { /* armazenamento indisponível: usa o padrão */ }
    })();

    // Animações reduzidas? (escolha feita no site ou, sem ela, a do sistema operacional)
    window.tlMovimentoReduzido = function () {
      var escolha = document.documentElement.getAttribute('data-motion');
      if (escolha === 'reduce') return true;
      if (escolha === 'full') return false;
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    };

    // Vibração curta em momentos-chave (gravar, tradução pronta). Só no celular e só se a pessoa
    // ligou "Vibração" nas configurações (desligada por padrão).
    window.tlVibrar = function (padrao) {
      try {
        if (localStorage.getItem('vibracao') === 'on' && navigator.vibrate
            && window.matchMedia('(pointer: coarse)').matches) navigator.vibrate(padrao);
      } catch (e) { /* sem suporte */ }
    };

    // Transição entre páginas: cancelada quando as animações estão reduzidas
    window.addEventListener('pagereveal', function (e) {
      if (!e.viewTransition) return;
      e.viewTransition.ready.catch(function () {}); // pular a transição rejeita "ready": não é erro
      if (window.tlMovimentoReduzido()) e.viewTransition.skipTransition();
    });
  </script>
  <%# A adesão à transição entre páginas fica aqui, no próprio HTML, e não no styleteste.css: o Chrome
      decide assim que a página nova chega e, se o CSS externo ainda estiver carregando, cancela a
      transição ("ViewTransition opt-in disabled"). O visual da transição continua no styleteste.css. %>
  <style>@view-transition { navigation: auto; }</style>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Serif+Display:ital@0;1&display=swap">
  <link rel="stylesheet" href="/css/styleteste.css">
  <% if (typeof cssExtra !== 'undefined' && cssExtra) { %><link rel="stylesheet" href="<%= cssExtra %>"><% } %>
</head>

<body<% if (typeof bodyClass !== 'undefined' && bodyClass) { %> class="<%= bodyClass %>"<% } %>>
