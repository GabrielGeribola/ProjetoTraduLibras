<%- include('includes/head') %>
<%- include('includes/navbar') %>

<div class="historico-container">
  <h1 class="historico-title">Histórico</h1>

  <% if (bloqueado) { %>
    <%# Visitante: a página existe e explica o que ganha ao entrar %>
    <div class="historico-bloqueado">
      <div class="historico-bloqueado-icone" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
      </div>
      <h2>Entre para ver seu histórico</h2>
      <p>O histórico guarda as traduções que você faz e os feedbacks que você deu, para você repetir uma tradução com um clique, em qualquer dispositivo.</p>
      <ul class="historico-beneficios">
        <li>Suas traduções salvas automaticamente</li>
        <li>“Traduzir de novo” com um clique</li>
        <li>Seus feedbacks guardados na sua conta</li>
      </ul>
      <div class="historico-bloqueado-acoes">
        <a href="/login?voltar=/historico" class="plano-botao">Entrar</a>
        <a href="/register" class="plano-botao plano-botao-secundario">Criar conta grátis</a>
      </div>
    </div>

  <% } else { %>
    <p class="historico-subtitulo">Suas traduções, da mais recente para a mais antiga.</p>

    <%- include('includes/messages') %>

    <% if (erroCarregar) { %>
      <p class="historico-vazio">Não foi possível carregar seu histórico agora. Tente novamente em instantes.</p>

    <% } else if (itens.length === 0) { %>
      <div class="historico-vazio">
        <p>Você ainda não fez nenhuma tradução.<br>Tudo o que você traduzir aparece aqui.</p>
        <a href="/home" class="btn-topic">Fazer uma tradução</a>
      </div>

    <% } else { %>
      <%# Linha do tempo: agrupado por dia (fuso de Brasília). Hoje, Ontem, dia da semana (até 6 dias) ou data. %>
      <%
        const FUSO = 'America/Sao_Paulo';
        const diaDe = (d) => new Date(d).toLocaleDateString('en-CA', { timeZone: FUSO }); // AAAA-MM-DD
        const hoje = diaDe(Date.now());
        const ontem = diaDe(Date.now() - 864e5);
        const rotuloDia = (dia) => {
          if (dia === hoje) return 'Hoje';
          if (dia === ontem) return 'Ontem';
          const data = new Date(`${dia}T12:00:00Z`);
          const dias = Math.round((new Date(`${hoje}T12:00:00Z`) - data) / 864e5);
          const texto = dias < 7
            ? data.toLocaleDateString('pt-BR', { timeZone: 'UTC', weekday: 'long' })
            : data.toLocaleDateString('pt-BR', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' });
          return texto.charAt(0).toUpperCase() + texto.slice(1);
        };
        const grupos = [];
        itens.forEach((item) => {
          if (!item.traducao) return;
          const dia = diaDe(item.data_traducao);
          if (!grupos.length || grupos[grupos.length - 1].dia !== dia) grupos.push({ dia, itens: [] });
          grupos[grupos.length - 1].itens.push(item);
        });
      %>
      <p class="sr-only" id="historicoAviso" role="status"></p>
      <div class="historico-linha-tempo">
        <% grupos.forEach(function (grupo) { %>
          <section class="historico-grupo" aria-label="<%= rotuloDia(grupo.dia) %>">
            <h2 class="historico-dia"><%= rotuloDia(grupo.dia) %></h2>
            <ul class="historico-lista">
              <% grupo.itens.forEach(function (item) {
                   const traducao = item.traducao;
                   const hora = new Date(item.data_traducao).toLocaleTimeString('pt-BR', { timeZone: FUSO, hour: '2-digit', minute: '2-digit' });
              %>
                <li class="historico-item">
                  <div class="historico-info">
                    <p class="historico-texto"><%= traducao.texto_original %></p>
                    <% const glosa = item.glosa || traducao.glosa; %>
                    <% if (glosa) { %>
                      <p class="historico-glosa">Glosa: <%= glosa %></p>
                    <% } %>
                    <span class="historico-data"><%= hora %></span>
                  </div>

                  <div class="historico-acoes">
                    <a href="/home?word=<%= encodeURIComponent(traducao.texto_original) %>" class="btn-topic">Traduzir de novo</a>
                    <form method="POST" action="/historico/<%= item.id_historico %>/excluir" class="form-excluir">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn-excluir" aria-label="Remover do histórico: <%= traducao.texto_original %>">Excluir</button>
                    </form>
                  </div>
                </li>
              <% }); %>
            </ul>
          </section>
        <% }); %>
      </div>
    <% } %>

    <%# Sinais que o usuário marcou como incorretos (👎) — só valem para ele %>
    <section class="sinais-ocultos" id="sinais-ocultos" aria-labelledby="sinaisOcultosTitulo">
      <h2 id="sinaisOcultosTitulo">Sinais ocultados por você</h2>
      <% if (exclusoes.length === 0) { %>
        <p class="sinais-ocultos-vazio">Quando você marcar um sinal como incorreto (👎) em uma tradução, ele aparece aqui. Ele deixa de ser usado só nas <strong>suas</strong> traduções, e você pode desfazer quando quiser.</p>
      <% } else { %>
        <p class="sinais-ocultos-info">Estes sinais não são usados nas suas traduções. Isso vale só para a sua conta.</p>
        <ul class="sinais-ocultos-lista">
          <% exclusoes.forEach(function (ex) { %>
            <li>
              <span class="sinais-ocultos-sinal"><%= ex.expressao.toUpperCase() %></span>
              <span class="sinais-ocultos-termo">para “<%= ex.termo %>”</span>
              <form method="POST" action="/feedback/exclusoes/restaurar">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="termo" value="<%= ex.termo %>">
                <input type="hidden" name="expressao" value="<%= ex.expressao %>">
                <button type="submit" class="btn-excluir">Voltar a usar</button>
              </form>
            </li>
          <% }); %>
        </ul>
        <% if (exclusoes.length > 1) { %>
          <form method="POST" action="/feedback/exclusoes/restaurar" class="sinais-ocultos-todos">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="todos" value="1">
            <button type="submit" class="btn-excluir">Voltar a usar todos</button>
          </form>
        <% } %>
      <% } %>
    </section>
  <% } %>
</div>

<script>
  // Excluir sem recarregar: o item sai e os de baixo sobem (movimento.js: tlReorganizar).
  // Se algo falhar, o formulário é enviado do jeito tradicional.
  (() => {
    const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
    const aviso = document.getElementById('historicoAviso');
    document.querySelectorAll('.form-excluir').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!confirm('Remover esta tradução do histórico?')) return;
        const item = form.closest('.historico-item');
        const botao = form.querySelector('button');
        botao.disabled = true;
        try {
          const resposta = await fetch(form.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { Accept: 'application/json', 'X-CSRF-Token': csrf },
            body: new URLSearchParams(new FormData(form)),
          });
          if (!resposta.ok) throw new Error(`HTTP ${resposta.status}`);
        } catch (erro) {
          botao.disabled = false;
          form.submit();
          return;
        }
        // Para onde vai o foco: o próximo item, o anterior ou o título
        const itens = [...document.querySelectorAll('.historico-item')];
        const posicao = itens.indexOf(item);
        const vizinho = itens[posicao + 1] || itens[posicao - 1];
        const grupo = item.closest('.historico-grupo');
        const remover = () => {
          item.remove();
          if (grupo && !grupo.querySelector('.historico-item')) grupo.remove();
        };
        const tudo = [...document.querySelectorAll('.historico-item, .historico-grupo')];
        if (window.tlReorganizar) window.tlReorganizar(tudo, remover); else remover();
        if (aviso) aviso.textContent = 'Tradução removida do histórico.';
        if (!document.querySelector('.historico-item')) { window.location.reload(); return; } // mostra o "ainda não fez nenhuma tradução"
        (vizinho?.querySelector('.btn-topic') || document.querySelector('.historico-title')).focus();
      });
    });
  })();
</script>

<%- include('includes/footer') %>
