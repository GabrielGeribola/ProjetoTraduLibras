<%- include('includes/head', { bodyClass: 'page-centered' }); %>
<%- include('includes/navbar'); %>

  <div class="container">

      <div class="logo-boasvindas-login">
        <img src="https://assetstradulibras.s3.us-east-1.amazonaws.com/imgs/logo-clara.png" alt="Logo TraduLibras" class="img-fluid" />
      </div>

      <div >
        <div >
          <%- include('includes/messages'); %>

          <div class="titulo-entrar">
            <h4 class="entrar">Entrar</h4>

            <form action="/login" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-group">
                <label class="diminutivo" for="login_email">Digite seu email</label>
                <br>
                <input type="email" class="form-control" id="login_email" name="email" placeholder="Email" autocomplete="email" required>
              </div>

              <div class="form-group">
                <label class="diminutivo" for="login_senha">Digite sua senha</label>
                <br>
                <input type="password" class="form-control" id="login_senha" name="password" placeholder="Senha" autocomplete="current-password" required>
              </div>

              <button type="submit" class="btn-btn-primary botaoacessar">Acessar</button>
            </form>

            <div class="linha"></div>
            <p class="tem-conta">Ainda não tem conta? </p>
            <a class="linkp-register" href="/register">Crie uma agora</a>
          </div>
        </div>
      </div>
  </div>

<%- include('includes/footer'); %>
