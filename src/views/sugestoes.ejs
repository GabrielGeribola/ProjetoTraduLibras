<%- include('includes/head') %>
<%- include('includes/navbar') %>
<main class="planos-container pagina-estreita">
<div class="planos-cabecalho">
  <h1 class="planos-titulo">Glossário</h1>
  <p class="planos-subtitulo">Palavras e expressões com sinal disponível. Clique em uma para ver a tradução.</p>
</div>
<div class="sugestoes-container">

  <label for="glossario-busca" class="sr-only">Buscar palavra no glossário</label>
  <input type="search" id="glossario-busca" class="input-home glossario-busca"
         placeholder="Buscar palavra..." autocomplete="off" maxlength="100">
  <p id="glossario-status" class="glossario-status" role="status" aria-live="polite">Carregando glossário…</p>

  <div class="scroll-area">
    <div id="glossario-resultados" class="glossario-grupo glossario-resultados" hidden></div>
    <div id="glossario-container"></div>
  </div>
</div>
</main>

<script src="/assets/js/glossario.js"></script>
<%- include('includes/footer') %>
