<%- include('includes/head') %>
<%- include('includes/navbar') %>

<main class="planos-container sobre-pagina">

  <div class="planos-cabecalho">
    <h1 class="planos-titulo">Sobre</h1>
    <p class="planos-subtitulo">Tradução de português para Libras, feita para aproximar pessoas ouvintes e surdas.</p>
  </div>

  <!-- Missão -->
  <section class="sobre-bloco" aria-labelledby="missaoTitulo">
    <h2 class="sobre-secao-titulo" id="missaoTitulo">Nossa missão</h2>
    <div class="sobre-cartao">
      <p>
        O TraduLibras nasceu para promover a inclusão e facilitar a comunicação entre pessoas ouvintes e surdas,
        traduzindo palavras e frases do português para a <strong>Língua Brasileira de Sinais (Libras)</strong>.
      </p>
      <p>
        Nosso compromisso é tornar a comunicação mais acessível e ajudar a construir um ambiente mais empático,
        inclusivo e respeitoso para todos.
      </p>
    </div>
  </section>

  <!-- O que oferecemos -->
  <section class="sobre-bloco" aria-labelledby="recursosTitulo">
    <h2 class="sobre-secao-titulo" id="recursosTitulo">O que você encontra aqui</h2>
    <div class="sobre-recursos">
      <a href="/home" class="sobre-recurso">
        <span class="sobre-recurso-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3l4 4-4 4"/><path d="M3 11V9a2 2 0 0 1 2-2h16"/><path d="M7 21l-4-4 4-4"/><path d="M21 13v2a2 2 0 0 1-2 2H3"/></svg>
        </span>
        <h3>Tradutor</h3>
        <p>Digite ou fale uma frase e veja a sequência de sinais em vídeo.</p>
      </a>
      <a href="/sugestoes" class="sobre-recurso">
        <span class="sobre-recurso-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </span>
        <h3>Glossário</h3>
        <p>Milhares de palavras com sinal disponível, organizadas por categoria.</p>
      </a>
      <a href="/cursos" class="sobre-recurso">
        <span class="sobre-recurso-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5C4.5 5 7.5 5 10 6.5V20c-2.5-1.5-5.5-1.5-8 0z"/><path d="M22 6.5C19.5 5 16.5 5 14 6.5V20c2.5-1.5 5.5-1.5 8 0z"/></svg>
        </span>
        <h3>Cursos</h3>
        <p>Vídeos e leituras selecionados para aprender Libras e a cultura surda.</p>
      </a>
      <a href="/historico" class="sobre-recurso">
        <span class="sobre-recurso-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v5h5"/><path d="M12 7v5l3.5 2"/></svg>
        </span>
        <h3>Histórico</h3>
        <p>Suas traduções e feedbacks guardados na sua conta.</p>
      </a>
    </div>
  </section>

  <!-- Quem somos -->
  <section class="sobre-bloco" aria-labelledby="quemTitulo">
    <h2 class="sobre-secao-titulo" id="quemTitulo">Quem somos</h2>
    <div class="planos-ong sobre-destaque">
      <span class="planos-ong-selo">FAM</span>
      <div class="planos-ong-texto">
        <h3>Um projeto acadêmico da FAM – Faculdade das Américas</h3>
        <p>
          Desenvolvido por estudantes de <strong>Análise e Desenvolvimento de Sistemas</strong>
          e <strong>Ciência da Computação</strong>.
        </p>
      </div>
    </div>
    <div class="sobre-cartao">
      <p>
        Seja você estudante, educador, familiar de uma pessoa surda ou simplesmente alguém interessado em aprender Libras,
        este espaço foi pensado para você. Agradecemos por fazer parte dessa jornada conosco.
      </p>
    </div>
  </section>

  <!-- Equipe -->
  <section class="sobre-bloco" aria-labelledby="equipeTitulo">
    <h2 class="sobre-secao-titulo" id="equipeTitulo">Conheça os participantes</h2>
    <ul class="dev-grid">
      <% equipe.forEach((pessoa) => { %>
        <li class="dev-card">
          <span class="dev-avatar" data-iniciais="<%= pessoa.iniciais %>">
            <% if (pessoa.foto) { %>
              <img src="<%= pessoa.foto %>" alt="" loading="lazy" referrerpolicy="no-referrer">
            <% } else { %>
              <%= pessoa.iniciais %>
            <% } %>
          </span>
          <h3><%= pessoa.nome %></h3>
          <% if (pessoa.link) { %>
            <div class="dev-links">
              <a href="<%= pessoa.link %>" target="_blank" rel="noopener noreferrer"><%= pessoa.rede %><span class="sr-only"> de <%= pessoa.nome %> (abre em nova aba)</span></a>
            </div>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </section>

  <div class="sobre-cta">
    <a href="/home" class="plano-botao">Começar a traduzir</a>
  </div>

</main>

<script>
  // Foto que não carrega vira as iniciais da pessoa (sem ícone de imagem quebrada)
  document.querySelectorAll('.dev-avatar img').forEach((img) => {
    const trocar = () => { const avatar = img.parentElement; avatar.textContent = avatar.dataset.iniciais; };
    if (img.complete && img.naturalWidth === 0) trocar();
    else img.addEventListener('error', trocar);
  });
</script>

<%- include('includes/footer') %>
